10 REM ===============================================================
20 REM LZS MINIMAL VERSION WITH MATCH SEARCH 3..31
30 REM FORMAT:
40 REM HEADER: "LZS1", WINDOW=127, MINLEN=3
50 REM FILE NAME IN HEADER: 8 BYTE BASE NAME + 3 BYTE EXTENSION
60 REM DOT IS NOT STORED
70 REM LITERAL 0..127 DIRECTLY
80 REM LITERAL 128..255 AS 255,BYTE
90 REM MATCH AS TOKEN,DIST
100 REM TOKEN = 128 + LEN - 3
110 REM THUS LEN 3..31 => TOKEN 128..156
120 REM ===============================================================

130 LET MAXW = 127
140 LET MAXL = 31
150 LET MINL = 3

160 LET INFILE$ = COMMAND$
170 IF LEN(INFILE$) > 0 THEN GOTO 200
180 PRINT "INPUT FILE?"
190 INPUT INFILE$

200 LET DOTP = INSTR(INFILE$, ".")
210 IF DOTP > 0 THEN GOTO 250
220 LET BASE$ = INFILE$
230 LET EXT$ = ""
240 GOTO 300

250 LET BASE$ = LEFT$(INFILE$, DOTP - 1)
260 LET EXT$ = MID$(INFILE$, DOTP + 1, LEN(INFILE$) - DOTP)
270 IF INSTR(EXT$, ".") = 0 THEN GOTO 300
280 PRINT "ERROR: INVALID FILE NAME"
290 END

300 IF LEN(BASE$) >= 1 AND LEN(BASE$) <= 8 THEN GOTO 330
310 PRINT "ERROR: BASE NAME MUST HAVE 1..8 CHARACTERS"
320 END

330 IF LEN(EXT$) <= 3 THEN GOTO 360
340 PRINT "ERROR: EXTENSION MUST HAVE 0..3 CHARACTERS"
350 END

360 GOSUB 8000
370 LET OUTFILE$ = BASE$ + ".LZS"
380 LET WIN$ = ""
390 LET LOOK$ = ""

395 LET DBG = 1
396 LET TC = 0
397 LET OPOS = 1

400 OPEN INFILE$ FOR INPUT AS #1
410 OPEN OUTFILE$ FOR OUTPUT AS #2

420 REM ---------- HEADER ----------
430 LET A = 76
440 PUT #2, A
450 LET A = 90
460 PUT #2, A
470 LET A = 83
480 PUT #2, A
490 LET A = 49
500 PUT #2, A
510 LET A = 127
520 PUT #2, A
530 LET A = 3
540 PUT #2, A

550 LET I = 1
560 LET CH$ = MID$(N8$, I, 1)
570 LET A = ASC(CH$)
580 PUT #2, A
590 LET I = I + 1
600 IF I <= 8 THEN GOTO 560

610 LET I = 1
620 LET CH$ = MID$(E3$, I, 1)
630 LET A = ASC(CH$)
640 PUT #2, A
650 LET I = I + 1
660 IF I <= 3 THEN GOTO 620

670 REM ---------- MAIN LOOP ----------
680 GOSUB 1000
690 IF LEN(LOOK$) = 0 THEN GOTO 900

700 GOSUB 2000
705 IF DBG = 0 THEN GOTO 710
706 REM PRINT "ENC FIND TOK="; TC; " POS="; OPOS; " BESTL="; BESTL; " BESTD="; BESTD
707 REM PRINT "ENC WB="; RIGHT$(WIN$, 24)
710 IF BESTL < MINL THEN GOTO 750
720 GOSUB 6000
730 GOSUB 1000
740 IF LEN(LOOK$) > 0 THEN GOTO 700
745 GOTO 900

750 GOSUB 3000
760 GOSUB 1000
770 IF LEN(LOOK$) > 0 THEN GOTO 700
780 GOTO 900

900 CLOSE #2
910 CLOSE #1
920 PRINT "OUTPUT: "; OUTFILE$
930 END

1000 REM ---------- FILL LOOKAHEAD UP TO MAXL ----------
1010 IF LEN(LOOK$) >= MAXL THEN RETURN
1020 IF EOF(1) = 1 THEN RETURN
1030 GET #1, A
1040 LET LOOK$ = LOOK$ + CHR$(A)
1050 GOTO 1010

2000 REM ---------- SEARCH BEST MATCH 3..31 ----------
2010 LET BESTL = 0
2020 LET BESTD = 0
2030 LET L = MAXL
2040 IF LEN(LOOK$) < L THEN LET L = LEN(LOOK$)
2050 IF LEN(WIN$) < L THEN LET L = LEN(WIN$)
2060 IF L < MINL THEN RETURN

2070 LET PAT$ = LEFT$(LOOK$, L)
2080 LET START = 1
2090 LET LASTP = 0

2100 LET POS = INSTR(START, WIN$, PAT$)
2110 IF POS = 0 THEN GOTO 2150
2120 LET LASTP = POS
2130 LET START = POS + 1
2140 GOTO 2100

2150 IF LASTP = 0 THEN GOTO 2200
2160 LET BESTL = L
2170 LET BESTD = LEN(WIN$) - LASTP + 1
2180 RETURN

2200 LET L = L - 1
2210 IF L >= MINL THEN GOTO 2070
2220 RETURN

3000 REM ---------- EMIT FIRST BYTE AS LITERAL ----------
3010 LET A$ = LEFT$(LOOK$, 1)
3020 LET A = ASC(A$)

3030 IF DBG = 0 THEN GOTO 3060
3040 REM PRINT "ENC LIT TOK="; TC; " POS="; OPOS; " BYTE="; A
3050 REM PRINT "ENC WB="; RIGHT$(WIN$, 24)

3060 IF A < 128 THEN GOTO 3100
3070 LET B = A
3080 LET A = 255
3090 PUT #2, A
3095 LET A = B

3100 PUT #2, A

3110 LET WIN$ = WIN$ + A$
3120 IF LEN(WIN$) > MAXW THEN LET WIN$ = RIGHT$(WIN$, MAXW)

3130 IF DBG = 0 THEN GOTO 3160
3140 REM PRINT "ENC WA="; RIGHT$(WIN$, 24)

3160 LET TC = TC + 1
3170 LET OPOS = OPOS + 1

3180 IF LEN(LOOK$) = 1 THEN LET LOOK$ = "": RETURN
3190 LET LOOK$ = MID$(LOOK$, 2, LEN(LOOK$) - 1)
3200 RETURN

6000 REM ---------- EMIT MATCH ----------
6010 LET TOKEN = 128 + BESTL - 3

6020 IF DBG = 0 THEN GOTO 6060
6030 REM PRINT "ENC MAT TOK="; TC; " POS="; OPOS; " LEN="; BESTL; " DIST="; BESTD
6040 REM PRINT "ENC PAT="; LEFT$(LOOK$, BESTL)
6050 REM PRINT "ENC WB="; RIGHT$(WIN$, 24)

6060 LET A = TOKEN
6070 PUT #2, A
6080 LET A = BESTD
6090 PUT #2, A

6100 LET PAT$ = LEFT$(LOOK$, BESTL)
6110 LET WIN$ = WIN$ + PAT$
6120 IF LEN(WIN$) > MAXW THEN LET WIN$ = RIGHT$(WIN$, MAXW)

6130 IF DBG = 0 THEN GOTO 6160
6140 REM PRINT "ENC WA="; RIGHT$(WIN$, 24)

6160 LET TC = TC + 1
6170 LET OPOS = OPOS + BESTL

6180 IF LEN(LOOK$) = BESTL THEN LET LOOK$ = "": RETURN
6190 LET LOOK$ = MID$(LOOK$, BESTL + 1, LEN(LOOK$) - BESTL)
6200 RETURN

8000 REM ---------- PREPARE BASE NAME/EXTENSION FOR HEADER ----------
8010 LET N8$ = BASE$
8020 IF LEN(N8$) >= 8 THEN GOTO 8050
8030 LET N8$ = N8$ + " "
8040 GOTO 8020
8050 IF LEN(N8$) = 8 THEN GOTO 8080
8060 LET N8$ = LEFT$(N8$, 8)

8080 LET E3$ = EXT$
8090 IF LEN(E3$) >= 3 THEN GOTO 8120
8100 LET E3$ = E3$ + " "
8110 GOTO 8090
8120 IF LEN(E3$) = 3 THEN RETURN
8130 LET E3$ = LEFT$(E3$, 3)
8140 RETURN
