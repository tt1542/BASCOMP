10 F$ = LTRIM$(RTRIM$(COMMAND$))
20 IF F$ <> "" THEN GOTO 50
30 PRINT "DATEI?"
40 INPUT F$
50 OPEN F$ FOR INPUT AS #1
60 H$ = "0123456789ABCDEF"
70 L$ = ""
80 A$ = ""
90 C = 0
100 D0 = 0: D1 = 0: D2 = 0: D3 = 0
110 IF EOF(1) <> 0 THEN GOTO 300
120 IF C <> 0 THEN GOTO 150
130 GOSUB 400
140 L$ = O$ + ": "
150 GET #1, B
160 HI = B / 16
170 LO = B MOD 16
180 L$ = L$ + MID$(H$, HI + 1, 1) + MID$(H$, LO + 1, 1) + " "
190 IF B < 32 THEN GOTO 220
200 IF B > 126 THEN GOTO 220
210 A$ = A$ + CHR$(B): GOTO 230
220 A$ = A$ + "."
230 C = C + 1
240 GOSUB 600
250 IF C < 16 THEN GOTO 110
260 PRINT L$; " "; A$
270 L$ = ""
280 A$ = ""
290 C = 0: GOTO 110

300 IF C = 0 THEN GOTO 360
310 GOSUB 500
320 PRINT L$; " "; A$
360 CLOSE #1
370 END

400 REM D3:D2:D1:D0 to O$ as 4-digit hex number
410 O$ = MID$(H$, D3 + 1, 1)
420 O$ = O$ + MID$(H$, D2 + 1, 1)
430 O$ = O$ + MID$(H$, D1 + 1, 1)
440 O$ = O$ + MID$(H$, D0 + 1, 1)
497 RETURN

500 REM padding remaining line in hex part to 16 bytes
510 IF C >= 16 THEN RETURN
520 P = 16 - C
530 IF P = 0 THEN RETURN
540 L$ = L$ + "   "
550 P = P - 1
560 GOTO 530

600 REM increment 4-digit hex offset D3:D2:D1:D0
610 D0 = D0 + 1
620 IF D0 < 16 THEN RETURN
630 D0 = 0
640 D1 = D1 + 1
650 IF D1 < 16 THEN RETURN
660 D1 = 0
670 D2 = D2 + 1
680 IF D2 < 16 THEN RETURN
690 D2 = 0
700 D3 = D3 + 1
710 IF D3 < 16 THEN RETURN
720 D3 = 0
730 RETURN