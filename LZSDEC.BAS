10 REM ===============================================================
20 REM LZS DECODER FOR FORMAT:
30 REM   HEADER: "LZS1", WINDOW, MINLEN, N8, E3
40 REM   N8 = 8 BYTE BASE NAME, E3 = 3 BYTE EXTENSION
50 REM   DOT IS NOT STORED
60 REM   LITERAL 0..127 DIRECTLY
70 REM   ESCAPE LITERAL 255,BYTE
80 REM   MATCH TOKEN,DIST WITH TOKEN=128..156 => LEN=3..31
90 REM   DEBUG OUTPUT CAN BE ENABLED VIA DBG
100 REM ===============================================================

110 LET INFILE$ = COMMAND$
120 IF LEN(INFILE$) > 0 THEN GOTO 150
130 PRINT "LZS FILE?"
140 INPUT INFILE$

150 LET WIN$ = ""
160 LET O = 0
170 LET DBG = 1
180 LET TC = 0
190 LET OPOS = 1

200 OPEN INFILE$ FOR INPUT AS #1

210 REM ---------- CHECK HEADER ----------
220 IF EOF(1) = 1 THEN GOTO 9000
230 GET #1, A
240 IF A = 76 THEN GOTO 270
250 PRINT "ERROR: NO LZS1 HEADER"
260 GOTO 9100

270 IF EOF(1) = 1 THEN GOTO 9000
280 GET #1, A
290 IF A = 90 THEN GOTO 320
300 PRINT "ERROR: NO LZS1 HEADER"
310 GOTO 9100

320 IF EOF(1) = 1 THEN GOTO 9000
330 GET #1, A
340 IF A = 83 THEN GOTO 370
350 PRINT "ERROR: NO LZS1 HEADER"
360 GOTO 9100

370 IF EOF(1) = 1 THEN GOTO 9000
380 GET #1, A
390 IF A = 49 THEN GOTO 420
400 PRINT "ERROR: NO LZS1 HEADER"
410 GOTO 9100

420 IF EOF(1) = 1 THEN GOTO 9000
430 GET #1, MAXW
440 IF MAXW > 0 THEN GOTO 470
450 PRINT "ERROR: INVALID WINDOW SIZE"
460 GOTO 9100

470 IF EOF(1) = 1 THEN GOTO 9000
480 GET #1, MINL
490 IF MINL = 3 THEN GOTO 520
500 PRINT "ERROR: MINLEN NOT SUPPORTED"
510 GOTO 9100

520 REM ---------- READ ORIGINAL NAMES ----------
530 LET N8$ = ""
540 LET E3$ = ""

550 LET I = 1
560 IF I > 8 THEN GOTO 620
570 IF EOF(1) = 1 THEN GOTO 9000
580 GET #1, A
590 LET N8$ = N8$ + CHR$(A)
600 LET I = I + 1
610 GOTO 560

620 LET I = 1
630 IF I > 3 THEN GOTO 690
640 IF EOF(1) = 1 THEN GOTO 9000
650 GET #1, A
660 LET E3$ = E3$ + CHR$(A)
670 LET I = I + 1
680 GOTO 630

690 LET N8$ = RTRIM$(N8$)
700 LET E3$ = RTRIM$(E3$)

710 IF LEN(E3$) = 0 THEN LET OUTFILE$ = N8$
720 IF LEN(E3$) > 0 THEN LET OUTFILE$ = N8$ + "." + E3$

730 OPEN OUTFILE$ FOR OUTPUT AS #2
740 LET O = 1

750 REM ---------- MAIN LOOP ----------
760 IF EOF(1) = 1 THEN GOTO 8000
770 GET #1, TOKEN

780 IF TOKEN = 255 THEN GOTO 1000
790 IF TOKEN < 128 THEN GOTO 2000
800 IF TOKEN <= 156 THEN GOTO 3000

810 PRINT "ERROR: INVALID TOKEN "; TOKEN
820 GOTO 9100

1000 REM ---------- ESCAPE LITERAL ----------
1010 IF EOF(1) = 1 THEN GOTO 9040
1020 GET #1, A

1030 IF DBG = 0 THEN GOTO 1060
1040 REM PRINT "DEC ESC TOK="; TC; " POS="; OPOS; " BYTE="; A
1050 REM PRINT "DEC WB="; RIGHT$(WIN$, 24)

1060 GOSUB 5000

1070 IF DBG = 0 THEN GOTO 1090
1080 REM PRINT "DEC WA="; RIGHT$(WIN$, 24)

1090 LET TC = TC + 1
1100 LET OPOS = OPOS + 1
1110 GOTO 760

2000 REM ---------- DIRECT LITERAL ----------
2010 IF DBG = 0 THEN GOTO 2040
2020 REM PRINT "DEC LIT TOK="; TC; " POS="; OPOS; " BYTE="; TOKEN
2030 REM PRINT "DEC WB="; RIGHT$(WIN$, 24)

2040 LET A = TOKEN
2050 GOSUB 5000

2060 IF DBG = 0 THEN GOTO 2080
2070 REM PRINT "DEC WA="; RIGHT$(WIN$, 24)

2080 LET TC = TC + 1
2090 LET OPOS = OPOS + 1
2100 GOTO 760

3000 REM ---------- MATCH TOKEN,DIST ----------
3010 LET LENM = TOKEN - 128 + 3
3020 IF EOF(1) = 1 THEN GOTO 9080
3030 GET #1, DIST

3040 IF DIST >= 1 THEN GOTO 3070
3050 PRINT "ERROR: INVALID DISTANCE "; DIST
3060 GOTO 9100

3070 IF DIST <= LEN(WIN$) THEN GOTO 3100
3080 PRINT "ERROR: DISTANCE TOO LARGE "; DIST
3090 GOTO 9100

3100 REM ---------- STABLE SOURCE WINDOW FOR MATCH ----------
3110 LET SRCW$ = WIN$
3120 LET COPYP = LEN(SRCW$) - DIST + 1

3130 IF DBG = 0 THEN GOTO 3170
3140 REM PRINT "DEC MAT TOK="; TC; " POS="; OPOS; " LEN="; LENM; " DIST="; DIST; " SRC="; COPYP
3150 REM PRINT "DEC WB="; RIGHT$(WIN$, 24)
3160 REM PRINT "DEC CPY="; MID$(SRCW$, COPYP, LENM)

3170 LET I = 1

3200 LET T$ = MID$(SRCW$, COPYP, 1)
3210 LET A = ASC(T$)
3220 GOSUB 5000
3230 LET COPYP = COPYP + 1
3240 LET I = I + 1
3250 IF I <= LENM THEN GOTO 3200

3260 IF DBG = 0 THEN GOTO 3280
3270 REM PRINT "DEC WA="; RIGHT$(WIN$, 24)

3280 LET TC = TC + 1
3290 LET OPOS = OPOS + LENM
3300 GOTO 760

5000 REM ---------- EMIT BYTE A AND ADD IT TO THE WINDOW ----------
5010 PUT #2, A
5020 LET WIN$ = WIN$ + CHR$(A)
5030 IF LEN(WIN$) <= MAXW THEN RETURN
5040 LET WIN$ = RIGHT$(WIN$, MAXW)
5050 RETURN

8000 IF O = 1 THEN CLOSE #2
8010 CLOSE #1
8020 PRINT "DECODED: "; OUTFILE$
8030 END

9000 PRINT "ERROR: FILE TOO SHORT IN HEADER"
9010 IF O = 1 THEN CLOSE #2
9020 CLOSE #1
9030 END

9040 PRINT "ERROR: ESCAPE WITHOUT FOLLOWING BYTE"
9050 IF O = 1 THEN CLOSE #2
9060 CLOSE #1
9070 END

9080 PRINT "ERROR: MATCH WITHOUT DISTANCE"
9090 IF O = 1 THEN CLOSE #2
9100 CLOSE #1
9110 END
