10 REM ===============================================================
20 REM QBMAKE.BAS
30 REM CONVERTS LINE-NUMBERED FULLTES2/FULLTEST TO QB MODE
40 REM FOR BASCOMP: LABELS L<LINE NUMBER>, NO LINE NUMBERS
50 REM ===============================================================
60 PRINT "QBMAKE - BASCOMP QB MODE CONVERTER"
70 PRINT "INPUT FILE?"
80 INPUT IN$
90 PRINT "OUTPUT FILE?"
100 INPUT OU$
110 DIM TG(1024)
120 DIM UF(1024)
130 LET TC = 0
140 REM ---------- PASS 1: COLLECT JUMP TARGETS ----------
150 OPEN IN$ FOR INPUT AS #1
160 IF EOF(1) <> 0 THEN GOTO 230
170 LINE INPUT #1, L$
180 GOSUB 1000
190 IF N = 0 THEN GOTO 160
200 GOSUB 2000
210 GOTO 160
230 CLOSE #1
240 PRINT "TARGETS FOUND:"; TC
250 REM ---------- PASS 2: GENERATE OUTPUT ----------
260 OPEN IN$ FOR INPUT AS #1
270 OPEN OU$ FOR OUTPUT AS #2
280 PRINT #2, "REM ==============================================================="
290 PRINT #2, "REM QB MODE VARIANT FOR BASCOMP"
300 PRINT #2, "REM GENERATED BY CONV2QB LOOPFIX"
310 PRINT #2, "REM ==============================================================="
320 IF EOF(1) <> 0 THEN GOTO 430
330 LINE INPUT #1, L$
340 GOSUB 1000
350 IF N = 0 THEN O$ = L$: GOTO 410
360 GOSUB 7000
370 GOSUB 1300
380 IF E <> 0 THEN PRINT #2, "L"; Q$; ":"
390 GOSUB 3000
400 O$ = W$
410 PRINT #2, O$
420 GOTO 320
430 CLOSE #1
440 CLOSE #2
450 GOSUB 8000
460 PRINT "DONE: "; OU$
470 END
1000 REM ---------- STRIP LINE NUMBER ----------
1010 B$ = L$
1020 N = 0
1030 L$ = LTRIM$(L$)
1040 IF LEN(L$) = 0 THEN RETURN
1050 N = VAL(L$)
1060 IF N = 0 THEN B$ = L$: RETURN
1070 I = 1
1080 IF I > LEN(L$) THEN B$ = "": RETURN
1090 C = ASC(MID$(L$, I, 1))
1100 IF C >= 48 AND C <= 57 THEN I = I + 1: GOTO 1080
1110 IF I > LEN(L$) THEN B$ = "": RETURN
1120 C = ASC(MID$(L$, I, 1))
1130 IF C = 32 THEN I = I + 1: GOTO 1110
1140 B$ = MID$(L$, I, LEN(L$) - I + 1)
1150 RETURN
1300 REM ---------- CURRENT LINE IS JUMP TARGET? ----------
1310 E = 0
1320 IF TC = 0 THEN RETURN
1330 R = 1
1335 IF R > TC THEN RETURN
1340 IF TG(R) = N THEN E = 1: UF(R) = 1: RETURN
1345 R = R + 1
1350 GOTO 1335
1360 RETURN
2000 REM ---------- PASS1: SEARCH GOTO/GOSUB TARGETS IN B$ ----------
2010 I = 1
2020 S = 0
2030 IF I > LEN(B$) THEN RETURN
2040 C$ = MID$(B$, I, 1)
2050 IF C$ <> CHR$(34) THEN GOTO 2080
2060 IF S = 0 THEN S = 1 ELSE S = 0
2070 I = I + 1: GOTO 2030
2080 IF S <> 0 THEN I = I + 1: GOTO 2030
2090 IF C$ = "'" THEN RETURN
2100 GOSUB 4000: IF E <> 0 THEN RETURN
2110 IF MID$(B$, I, 4) = "GOTO" THEN J = I + 4: GOSUB 2500: GOTO 2030
2120 IF MID$(B$, I, 5) = "GOSUB" THEN J = I + 5: GOSUB 2500: GOTO 2030
2130 I = I + 1
2140 GOTO 2030
2500 REM ---------- READ NUMERIC TARGET LIST FROM J ----------
2510 K = J
2520 IF K > LEN(B$) THEN I = K: RETURN
2530 C = ASC(MID$(B$, K, 1))
2540 IF C = 32 OR C = 9 THEN K = K + 1: GOTO 2520
2550 NUM$ = ""
2560 IF K > LEN(B$) THEN GOTO 2640
2570 C = ASC(MID$(B$, K, 1))
2580 IF C < 48 OR C > 57 THEN GOTO 2640
2590 NUM$ = NUM$ + MID$(B$, K, 1)
2600 K = K + 1
2610 GOTO 2560
2640 TARGET = VAL(NUM$)
2650 IF TARGET = 0 THEN I = K: RETURN
2670 IF TC = 0 THEN GOTO 2730
2680 R = 1
2685 IF R > TC THEN GOTO 2730
2690 IF TG(R) = TARGET THEN GOTO 2770
2695 R = R + 1
2700 GOTO 2685
2730 IF TC >= 1024 THEN PRINT "ERROR: TARGET LIST FULL": END 1
2740 TC = TC + 1
2750 TG(TC) = TARGET
2760 UF(TC) = 0
2770 IF K > LEN(B$) THEN I = K: RETURN
2772 C = ASC(MID$(B$, K, 1))
2774 IF C <> 44 THEN I = K: RETURN
2776 K = K + 1
2778 GOTO 2520
3000 REM ---------- PASS2: CONVERT BODY B$ TO W$ ----------
3010 W$ = ""
3020 I = 1
3030 S = 0
3040 IF I > LEN(B$) THEN RETURN
3050 C$ = MID$(B$, I, 1)
3060 IF C$ <> CHR$(34) THEN GOTO 3100
3070 IF S = 0 THEN S = 1 ELSE S = 0
3080 W$ = W$ + C$
3090 I = I + 1: GOTO 3040
3100 IF S <> 0 THEN W$ = W$ + C$: I = I + 1: GOTO 3040
3110 IF C$ = "'" THEN W$ = W$ + MID$(B$, I, LEN(B$) - I + 1): RETURN
3120 GOSUB 4000: IF E <> 0 THEN W$ = W$ + MID$(B$, I, LEN(B$) - I + 1): RETURN
3130 IF MID$(B$, I, 4) = "GOTO" THEN W$ = W$ + "GOTO": J = I + 4: GOSUB 3500: GOTO 3040
3140 IF MID$(B$, I, 5) = "GOSUB" THEN W$ = W$ + "GOSUB": J = I + 5: GOSUB 3500: GOTO 3040
3150 W$ = W$ + C$
3160 I = I + 1
3170 GOTO 3040
3500 REM ---------- REPLACE NUMERIC TARGET LIST WITH LABELS ----------
3510 K = J
3520 SP$ = ""
3530 IF K > LEN(B$) THEN I = K: RETURN
3540 C = ASC(MID$(B$, K, 1))
3550 IF C = 32 OR C = 9 THEN SP$ = SP$ + MID$(B$, K, 1): K = K + 1: GOTO 3530
3560 NUM$ = ""
3570 IF K > LEN(B$) THEN GOTO 3650
3580 C = ASC(MID$(B$, K, 1))
3590 IF C < 48 OR C > 57 THEN GOTO 3650
3600 NUM$ = NUM$ + MID$(B$, K, 1)
3610 K = K + 1
3620 GOTO 3570
3650 IF LEN(NUM$) = 0 THEN W$ = W$ + SP$: I = K: RETURN
3660 W$ = W$ + SP$ + "L" + NUM$
3670 IF K > LEN(B$) THEN I = K: RETURN
3672 C = ASC(MID$(B$, K, 1))
3674 IF C <> 44 THEN I = K: RETURN
3676 W$ = W$ + ","
3678 K = K + 1: SP$ = "": GOTO 3530
4000 REM ---------- REM KEYWORD AT I? RESULT E ----------
4010 E = 0
4020 IF MID$(B$, I, 3) <> "REM" THEN RETURN
4030 IF I > 1 THEN C = ASC(MID$(B$, I - 1, 1)): IF C <> 32 AND C <> 9 AND C <> 58 THEN RETURN
4040 IF I + 3 > LEN(B$) THEN E = 1: RETURN
4050 C = ASC(MID$(B$, I + 3, 1))
4060 IF C >= 65 AND C <= 90 OR C >= 48 AND C <= 57 OR C = 95 OR C = 36 THEN RETURN
4070 E = 1
4080 RETURN
7000 REM ---------- FORMAT N TO Q$ ----------
7010 Q$ = STR$(N)
7020 Q$ = LTRIM$(RTRIM$(Q$))
7030 RETURN
8000 REM ---------- WARNINGS FOR TARGETS NOT FOUND ----------
8010 IF TC = 0 THEN RETURN
8020 R = 1
8025 IF R > TC THEN RETURN
8030 IF UF(R) = 0 THEN Q$ = STR$(TG(R)): Q$ = LTRIM$(RTRIM$(Q$)): PRINT "WARNING: LABEL L"; Q$; " NOT EMITTED"
8040 R = R + 1
8045 GOTO 8025
