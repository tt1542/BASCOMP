10 REM ===============================================================
20 REM BASM.BAS
30 REM Special assembler for BASCOMP assembler output
40 REM Target: 16-bit DOS COM file, ORG 100h
60 REM ===============================================================
70 REM ---------------------------------------------------------------
80 REM Used variables
90 REM ---------------------------------------------------------------
100 REM A$  = current input line
110 REM B$  = normalized line
120 REM C$  = helper string / token
130 REM D$  = input filename
140 REM E$  = output filename
150 REM F$  = preprocessor temporary file
160 REM G$  = symbol temporary file / debug
162 REM HAT$ = alias target table for %XDEFINE label aliases
165 REM DF$ = command line -D defines, separated by spaces
170 REM I,J,K,L = general indices
180 REM CP = current code pointer, logical from ORG
185 REM HS/PS/VS/RS/TS = unsigned byte counts for header/program/variables/runtime/total
200 REM PASS = current pass
210 REM ERR = error flag
230 REM SCNT = symbol count
240 REM DCNT = define count
250 REM ACNT = alias symbol count
260 REM ACTLVL = IFDEF nesting depth
270 REM NN = reserved numeric bytes, corresponds to __N
280 REM SS = reserved string bytes, corresponds to __S
290 REM ---------------------------------------------------------------
300 REM Tables
310 REM ---------------------------------------------------------------
320 DIM SA(8700)
330 DIM AO(500)
335 DIM AV(500)
340 DIM AT(500)
350 DIM ACT(16)
355 DIM HT(2003)
356 DIM NX(8700)
357 DIM SLN(8700)
358 DIM SFC(8700)
359 DIM SLC(8700)
361 DIM P1A(30000): REM P1A = CP/address per real code/data line
362 DIM P1K(30000): REM P1K = byte length per real code/data line
363 DIM LI(8700): REM LI = label symbol index
364 DIM LA(8700): REM LA = P1 anchor line for label
365 DIM JLN(3000): REM JLN = jump line; positive=Jcc, negative=JMP
366 DIM JTG(3000): REM JTG = resolved target symbol index per jump
369 REM ---------------------------------------------------------------
370 REM Program start
380 REM ---------------------------------------------------------------
381 DIM A$ AS STRING * 127
382 DIM B$ AS STRING * 127
383 DIM R$ AS STRING * 127
384 DIM C$ AS STRING * 127
385 DIM T$ AS STRING * 80
386 DIM T1$ AS STRING * 80
387 DIM T2$ AS STRING * 80
388 DIM S$ AS STRING * 80
389 DIM U$ AS STRING * 80
390 DIM SYM$ AS STRING * 20
391 DIM LCS$ AS STRING * 20
399 PRINT "BASM - BASCOMP SPECIAL ASSEMBLER - 1.4"
400 D$ = LTRIM$(RTRIM$(COMMAND$))
405 ORJMP = 0: DF$ = "": REM command line options: /R and -DNAME
410 IF LEN(D$) <> 0 THEN GOTO 450
420 PRINT "FILE?"
430 INPUT D$
440 D$ = LTRIM$(RTRIM$(D$))
450 GOSUB 16700
460 IF ERR <> 0 THEN 
470   PRINT "USAGE: BASM file[.AS2|.ASM] [/R] [-DNAME] [-D NAME]"
480   REM PRINT "   /R: Toggles JMP relaxation (smaller code, but SLOW!)"
485   REM PRINT "   -D: Defines assembler symbol for %IFDEF/%IFNDEF"
500   END
505 END IF
510 GOSUB 610
520 IF ERR <> 0 THEN GOTO 8930
530 GOSUB 870
540 IF ERR <> 0 THEN GOTO 8930
550 GOSUB 2130
560 IF ERR <> 0 THEN GOTO 8930
570 GOSUB 2420
580 IF ERR <> 0 THEN GOTO 8930
585 GOSUB 18660
590 PRINT "DONE."
600 END
610 REM ==============================================================
620 REM INIT
630 REM ==============================================================
690 ACTLVL = 1
700 ACT(1) = 1
705 WSYM = 0: REM Set to 1 to write symbols to the file
706 RJMP = ORJMP: REM 0=fast, JMP always near; 1=relax JMP too
720 CP = 256
750 REM HSN$/HSN2$ moved to external XALLOC symbol-name storage
755 SN1 = XALLOC(2900,20)
756 SN2 = XALLOC(2900,20)
757 SN3 = XALLOC(2900,20)
758 IF SN1 = 0 OR SN2 = 0 OR SN3 = 0 THEN ERR = 1: PRINT "ERROR: SYMBOL NAME STORAGE": RETURN
759 JTN = XALLOC(3000,20)
760 IF JTN = 0 THEN ERR = 1: PRINT "ERROR: JUMP TARGET STORAGE": RETURN
761 P1MAX = 30000
762 JMAX = 3000
763 LMAX = 8700
770 DIM HDN$(200) AS STRING * 31
790 DIM HAN$(500) AS STRING * 20
802 DIM HAT$(500) AS STRING * 20
810 GOSUB 830
820 RETURN
830 REM ---- Predefined names
840 C$ = "OFFSET": GOSUB 2650
850 C$ = "PTR": GOSUB 2650
855 GOSUB 18000
860 RETURN
870 REM ==============================================================
880 REM PREPROCESS
890 REM Reads D$ and writes active, reduced lines to F$
900 REM ==============================================================
910 PRINT "PREPROCESS "; D$; " -> "; F$
920 OPEN D$ FOR INPUT AS #1
930 OPEN F$ FOR OUTPUT AS #2
950 IF EOF(1) <> 0 THEN GOTO 1160
960 LINE INPUT #1, A$
980 GOSUB 3010
990 IF LEN(B$) = 0 THEN GOTO 950
1000 REM ---- Skip macro definitions ----
1010 IF LEFT$(B$, 6) = "%MACRO" THEN GOSUB 1190: GOTO 950
1020 REM ---- Always process IFDEF/IFNDEF/ENDIF ----
1030 IF LEFT$(B$, 6) = "%IFDEF" THEN GOSUB 1470: GOTO 950
1040 IF LEFT$(B$, 7) = "%IFNDEF" THEN GOSUB 1570: GOTO 950
1050 IF LEFT$(B$, 6) = "%ENDIF" THEN GOSUB 1680: GOTO 950
1055 IF LEFT$(B$, 5) = "%ELSE" THEN GOSUB 1705: GOTO 950
1060 REM ---- Ignore everything else in inactive blocks ----
1070 IF ACT(ACTLVL) = 0 THEN GOTO 950
1080 REM ---- Process preprocessor directives only when active ----
1090 IF LEFT$(B$, 1) = "%" THEN GOSUB 1260: GOTO 950
1100 REM ---- Process BASCOMP special macros only when active ----
1110 GOSUB 1720
1120 IF K <> 0 THEN GOTO 950
1130 REM ---- Output active normal line ----
1140 PRINT #2, B$
1150 GOTO 950
1160 CLOSE #1
1170 CLOSE #2
1180 RETURN
1190 REM ---- SKIP MACRO BODY UNTIL %ENDMACRO
1200 IF EOF(1) <> 0 THEN ERR = 1: PRINT "ERROR: MISSING %ENDMACRO": RETURN
1210 LINE INPUT #1, A$
1230 GOSUB 3010
1240 IF LEFT$(B$, 9) = "%ENDMACRO" THEN RETURN
1250 GOTO 1200
1260 REM ---- HANDLE % DIRECTIVE
1270 REM Expected active forms: %DEFINE, %ASSIGN, %XDEFINE
1280 IF LEFT$(B$, 7) = "%DEFINE" THEN GOTO 1350
1290 IF LEFT$(B$, 7) = "%ASSIGN" THEN GOTO 1400
1300 IF LEFT$(B$, 8) = "%XDEFINE" THEN GOTO 1430
1340 RETURN
1350 REM ---- %DEFINE NAME
1360 C$ = MID$(B$, 9, LEN(B$) - 8)
1370 C$ = LTRIM$(RTRIM$(C$))
1380 GOSUB 2650
1390 RETURN
1400 REM ---- %ASSIGN NAME VALUE
1410 GOSUB 2730
1420 RETURN
1430 REM ---- %XDEFINE NAME EXPR
1440 GOSUB 18400
1460 RETURN
1470 REM ---- %IFDEF NAME
1480 C$ = MID$(B$, 8, LEN(B$) - 7)
1490 C$ = LTRIM$(RTRIM$(C$))
1500 GOSUB 2870
1505 IF K <> 0 THEN GOTO 1510
1506 GOSUB 2940
1510 IF ACTLVL >= 16 THEN GOSUB 20680: RETURN
1520 ACTLVL = ACTLVL + 1
1530 ACT(ACTLVL) = 0
1540 IF ACT(ACTLVL - 1) = 0 THEN GOTO 1560
1550 IF K <> 0 THEN ACT(ACTLVL) = 1
1560 RETURN
1570 REM ---- %IFNDEF NAME
1580 C$ = MID$(B$, 9, LEN(B$) - 8)
1590 C$ = LTRIM$(RTRIM$(C$))
1600 GOSUB 2870
1605 IF K <> 0 THEN GOTO 1610
1606 GOSUB 2940
1610 IF K = 0 THEN K = 1 ELSE K = 0
1620 IF ACTLVL >= 16 THEN GOSUB 20680: RETURN
1630 ACTLVL = ACTLVL + 1
1640 ACT(ACTLVL) = 0
1650 IF ACT(ACTLVL - 1) = 0 THEN GOTO 1670
1660 IF K <> 0 THEN ACT(ACTLVL) = 1
1670 RETURN
1680 REM ---- %ENDIF
1690 IF ACTLVL = 1 THEN ERR = 1: PRINT "ERROR: %ENDIF WITHOUT %IF": RETURN
1700 ACTLVL = ACTLVL - 1
1701 RETURN
1705 REM ---- %ELSE
1706 IF ACTLVL = 1 THEN ERR = 1: PRINT "ERROR: %ELSE WITHOUT %IF": RETURN
1707 IF ACT(ACTLVL - 1) = 0 THEN ACT(ACTLVL) = 0: RETURN
1708 IF ACT(ACTLVL) = 0 THEN ACT(ACTLVL) = 1 ELSE ACT(ACTLVL) = 0
1709 RETURN
1720 REM ---- HANDLE BASCOMP MACRO CALLS: REQ, DN, DS, DSLEN, DSA
1730 K = 0
1740 IF LEFT$(B$, 4) = "REQ " THEN GOTO 1780
1750 IF LEFT$(B$, 3) = "DN " THEN GOTO 1850
1760 IF LEFT$(B$, 3) = "DS " THEN GOTO 1990
1765 IF LEFT$(B$, 6) = "DSLEN " THEN GOTO 1990
1767 IF LEFT$(B$, 4) = "DSA " THEN GOTO 1990
1770 RETURN
1780 REM ---- REQ MODULEEE -> DEFINE USE_MODULEEE
1790 C$ = MID$(B$, 5, LEN(B$) - 4)
1800 C$ = LTRIM$(RTRIM$(C$))
1810 C$ = "USE_" + C$
1820 GOSUB 2650
1830 K = 1
1840 RETURN
1850 REM ---- DN NAME -> alias N_NAME = NV + NN; NN += 2
1860 C$ = MID$(B$, 4, LEN(B$) - 3)
1870 C$ = LTRIM$(RTRIM$(C$))
1880 C$ = "N_" + C$
1890 GOSUB 2940
1900 IF K <> 0 THEN GOTO 1970
1910 IF ACNT >= 500 THEN GOSUB 20600: RETURN
1920 ACNT = ACNT + 1
1921 LCA$ = "": LCAK = 0
1930 HAN$(ACNT) = C$
1940 AT(ACNT) = 1
1950 AO(ACNT) = NN
1960 NN = NN + 2
1970 K = 1
1980 RETURN
1990 REM ---- DS NAME / DSLEN NAME,MAXLEN / DSA NAME,COUNT -> alias S_NAME = SV + SS
1992 SIZE = 256
1994 IF LEFT$(B$, 6) = "DSLEN " THEN R$ = MID$(B$, 7, LEN(B$) - 6): GOTO 2008
1996 IF LEFT$(B$, 4) = "DSA " THEN R$ = MID$(B$, 5, LEN(B$) - 4): GOTO 2024
2000 C$ = MID$(B$, 4, LEN(B$) - 3): GOTO 2032
2008 R$ = LTRIM$(RTRIM$(R$)): J = INSTR(R$, ",")
2010 IF J = 0 THEN ERR = 1: PRINT "ERROR: DSLEN FORM "; B$: RETURN
2012 C$ = LTRIM$(RTRIM$(LEFT$(R$, J - 1))): T$ = LTRIM$(RTRIM$(MID$(R$, J + 1, LEN(R$) - J)))
2014 IF LEN(C$) = 0 OR LEN(T$) = 0 THEN ERR = 1: PRINT "ERROR: DSLEN FORM "; B$: RETURN
2016 GOSUB 5130: IF ERR <> 0 THEN RETURN
2018 IF V < 1 OR V > 255 THEN ERR = 1: PRINT "ERROR: DSLEN SIZE "; B$: RETURN
2020 SIZE = V + 1: GOTO 2032
2024 R$ = LTRIM$(RTRIM$(R$)): J = INSTR(R$, ",")
2025 IF J = 0 THEN ERR = 1: PRINT "ERROR: DSA FORM "; B$: RETURN
2026 C$ = LTRIM$(RTRIM$(LEFT$(R$, J - 1))): T$ = LTRIM$(RTRIM$(MID$(R$, J + 1, LEN(R$) - J)))
2027 IF LEN(C$) = 0 OR LEN(T$) = 0 THEN ERR = 1: PRINT "ERROR: DSA FORM "; B$: RETURN
2028 GOSUB 5130: IF ERR <> 0 THEN RETURN
2029 IF V < 1 OR V > 32767 THEN ERR = 1: PRINT "ERROR: DSA SIZE "; B$: RETURN
2030 IF V <= 127 THEN SIZE = 1 + 2 * V ELSE SIZE = 2
2032 C$ = LTRIM$(RTRIM$(C$))
2040 C$ = "S_" + C$
2050 GOSUB 2940
2060 IF K <> 0 THEN GOTO 2110
2070 IF ACNT >= 500 THEN GOSUB 20600: RETURN
2080 ACNT = ACNT + 1
2081 LCA$ = "": LCAK = 0
2090 HAN$(ACNT) = C$
2092 AT(ACNT) = 2
2094 AO(ACNT) = SS
2100 SS = SS + SIZE
2110 K = 1
2120 RETURN
2130 REM ==============================================================
2140 REM PASS 1 - SYMBOL AND ADDRESS CALCULATION / RELAXATION
2150 REM ==============================================================
2160 PRINT "PASS 1 "; F$; " -"; "> "; G$
2170 PASS = 1
2172 GOSUB 19300
2174 IF ERR <> 0 THEN RETURN
2176 GOSUB 19840
2178 IF ERR <> 0 THEN RETURN
2180 GOSUB 19950
2182 IF ERR <> 0 THEN RETURN
2310 IF WSYM <> 0 THEN GOSUB 2330
2315 GOSUB 16360
2316 IF ERR <> 0 THEN RETURN
2320 RETURN
2330 REM ---- WRITE SYMBOL DEBUG FILE
2340 OPEN G$ FOR OUTPUT AS #3
2350 I = 1
2360 IF I > SCNT THEN GOTO 2400
2370 SYI = I: GOSUB 19100
2372 IF ERR <> 0 THEN RETURN
2374 PRINT #3, SYM$; " "; SA(I)
2380 I = I + 1
2390 GOTO 2360
2400 CLOSE #3
2410 RETURN
2420 REM ==============================================================
2430 REM PASS 2 - CODE GENERATION
2440 REM ==============================================================
2450 PRINT "PASS 2 "; G$; " -> "; E$
2460 PASS = 2
2470 CP = 256
2480 OPEN F$ FOR INPUT AS #1
2490 OPEN E$ FOR OUTPUT AS #2
2500 IF EOF(1) <> 0 THEN GOTO 2590
2510 LINE INPUT #1, B$
2520 IF LEN(B$) = 0 THEN GOTO 2500
2530 GOSUB 3460
2540 IF ERR <> 0 THEN CLOSE #1: CLOSE #2: RETURN
2550 IF LEN(B$) = 0 THEN GOTO 2500
2560 GOSUB 4700
2570 IF ERR <> 0 THEN PRINT "ERROR PASS2 LINE: "; B$: CLOSE #1: CLOSE #2: RETURN
2580 GOTO 2500
2590 CLOSE #1
2600 CLOSE #2
2610 RETURN
2620 REM ==============================================================
2630 REM DEFINE/ALIAS HELPER ROUTINES
2640 REM ==============================================================
2650 REM ---- ADD DEFINE C$
2660 IF LEN(C$) = 0 THEN RETURN
2670 GOSUB 2870
2680 IF K <> 0 THEN RETURN
2690 IF DCNT >= 200 THEN ERR = 1: PRINT "ERROR: DEFINE TABLE FULL": RETURN
2700 DCNT = DCNT + 1
2705 LCD$ = "": LCDK = 0
2710 HDN$(DCNT) = C$
2720 RETURN
2730 REM ---- SIMPLE ASSIGN PARSER
2740 REM Expects: %ASSIGN NAME VALUE or %XDEFINE NAME VALUE
2750 I = INSTR(B$, " ")
2760 IF I = 0 THEN RETURN
2770 C$ = MID$(B$, I + 1, LEN(B$) - I)
2780 C$ = LTRIM$(RTRIM$(C$))
2790 I = INSTR(C$, " ")
2800 IF I = 0 THEN RETURN
2810 D1$ = LEFT$(C$, I - 1)
2820 D2$ = MID$(C$, I + 1, LEN(C$) - I)
2830 D2$ = LTRIM$(RTRIM$(D2$))
2840 IF D1$ = "__N" THEN NN = VAL(D2$)
2850 IF D1$ = "__S" THEN SS = VAL(D2$)
2860 RETURN
2870 REM ---- IS DEFINE C$? Result K
2875 IF C$ = LCD$ THEN K = LCDK: RETURN
2880 K = 0
2890 I = 1
2900 IF I > DCNT THEN LCD$ = C$: LCDK = 0: RETURN
2910 IF HDN$(I) = C$ THEN K = 1: LCD$ = C$: LCDK = K: RETURN
2920 I = I + 1
2930 GOTO 2900
2940 REM ---- IS ALIAS C$? Result K
2945 IF C$ = LCA$ THEN K = LCAK: RETURN
2950 K = 0
2960 I = 1
2970 IF I > ACNT THEN LCA$ = C$: LCAK = 0: RETURN
2980 IF HAN$(I) = C$ THEN K = I: LCA$ = C$: LCAK = K: RETURN
2990 I = I + 1
3000 GOTO 2970
3010 REM ==============================================================
3020 REM NORMALIZE LINE
3030 REM Input A$, Output B$
3040 REM ==============================================================
3050 B$ = A$
3060 GOSUB 3100
3070 B$ = LTRIM$(RTRIM$(B$))
3080 GOSUB 3200
3090 RETURN
3100 REM ---- STRIP COMMENT OUTSIDE QUOTES
3110 Q = 0
3120 I = 1
3130 IF I > LEN(B$) THEN RETURN
3140 C = ASC(MID$(B$, I, 1))
3150 IF C <> 34 THEN GOTO 3170
3160 IF Q = 0 THEN Q = 1 ELSE Q = 0
3170 IF C = 59 AND Q = 0 THEN B$ = LEFT$(B$, I - 1): RETURN
3180 I = I + 1
3190 GOTO 3130
3200 REM ---- UPPERCASE OUTSIDE QUOTES
3210 R$ = ""
3220 Q = 0
3230 I = 1
3240 IF I > LEN(B$) THEN B$ = R$: RETURN
3250 C = ASC(MID$(B$, I, 1))
3260 IF C = 9 THEN C = 32
3270 IF C <> 34 THEN GOTO 3290
3280 IF Q = 0 THEN Q = 1 ELSE Q = 0
3290 IF Q <> 0 THEN GOTO 3330
3300 IF C < 97 THEN GOTO 3330
3310 IF C > 122 THEN GOTO 3330
3320 C = C - 32
3330 R$ = R$ + CHR$(C)
3340 I = I + 1
3350 GOTO 3240
3360 REM ==============================================================
3370 REM LABEL AND SYMBOL ROUTINES
3380 REM ==============================================================
3390 REM ---- FIND SYMBOL C$, result K=index or 0
3400 K = 0
3401 CLN = LEN(C$)
3402 IF CLN = 0 THEN RETURN
3403 CFC = ASC(LEFT$(C$,1))
3404 CLC = ASC(RIGHT$(C$,1))
3405 IF C$ = LCS$ THEN K = LCK: RETURN
3406 GOSUB 16500
3407 I = HT(HH)
3410 IF I = 0 THEN RETURN
3420 IF SLN(I) <> CLN THEN GOTO 3450
3422 IF SFC(I) <> CFC THEN GOTO 3450
3424 IF SLC(I) <> CLC THEN GOTO 3450
3425 SYI = I
3426 GOSUB 19100
3427 IF ERR <> 0 THEN RETURN
3430 IF SYM$ = C$ THEN K = I: LCS$ = C$: LCK = K: RETURN
3450 I = NX(I): GOTO 3410
3460 REM ---- HANDLE OPTIONAL LABEL, CHANGES B$ ----
3470 REM Detects LABEL:, LABEL: remainder, and LABEL DB/DW/TIMES
3480 J = INSTR(B$, ":")
3490 IF J = 0 THEN GOTO 3650
3500 I = INSTR(B$, " ")
3510 IF I = 0 THEN GOTO 3530
3520 IF J > I THEN GOTO 3650
3530 C$ = LEFT$(B$, J - 1)
3540 C$ = LTRIM$(RTRIM$(C$))
3545 IF LEN(C$) > 20 THEN ERR = 1: PRINT "ERROR: LABEL TOO LONG "; C$: RETURN
3550 IF PASS <> 1 THEN GOTO 3612
3560 GOSUB 3390
3570 IF K = 0 THEN GOTO 3580
3572 IF SA(K) <> CP THEN CHG = 1
3574 SA(K) = CP
3576 GOTO 3620
3580 IF SCNT >= 8700 THEN GOSUB 20640: RETURN
3590 SCNT = SCNT + 1
3600 SYI = SCNT: SYM$ = C$: GOSUB 19200
3601 IF ERR <> 0 THEN RETURN
3602 SLN(SCNT) = LEN(C$): SFC(SCNT) = ASC(LEFT$(C$,1)): SLC(SCNT) = ASC(RIGHT$(C$,1))
3603 SA(SCNT) = CP
3604 IF C$ = "NV" THEN KNV = SCNT
3605 IF C$ = "SV" THEN KSV = SCNT
3606 IF C$ = "START" THEN KSTART = SCNT
3607 IF C$ = "ENDPROG" THEN KENDPROG = SCNT
3608 IF C$ = "RT_EXIT" THEN KRTEXIT = SCNT
3611 CHG = 1: GOSUB 16600: GOTO 3620
3612 GOSUB 3390
3614 IF K = 0 THEN ERR = 1: PRINT "ERROR: PASS2 UNKNOWN LABEL "; C$: RETURN
3616 IF SA(K) <> CP THEN ERR = 1: PRINT "ERROR: PASS2 LABEL ADDRESS "; C$; " "; SA(K); " "; CP: RETURN
3618 GOTO 3620
3620 B$ = MID$(B$, J + 1, LEN(B$) - J)
3630 B$ = LTRIM$(RTRIM$(B$))
3640 RETURN
3650 REM ---- LABEL WITHOUT COLON BEFORE DB/DW/TIMES
3660 J = INSTR(B$, " ")
3670 K = INSTR(B$, CHR$(9))
3680 IF J <> 0 THEN GOTO 3700
3690 J = K
3700 IF K = 0 THEN GOTO 3720
3710 IF K < J THEN J = K
3720 IF J = 0 THEN RETURN
3730 C$ = LEFT$(B$, J - 1)
3740 C$ = LTRIM$(RTRIM$(C$))
3745 IF LEN(C$) > 20 THEN ERR = 1: PRINT "ERROR: LABEL TOO LONG "; C$: RETURN
3750 R$ = MID$(B$, J + 1, LEN(B$) - J)
3760 IF LEN(R$) = 0 THEN RETURN
3770 IF LEFT$(R$, 1) = " " THEN R$ = MID$(R$, 2, LEN(R$) - 1): GOTO 3760
3780 IF LEFT$(R$, 1) = CHR$(9) THEN R$ = MID$(R$, 2, LEN(R$) - 1): GOTO 3760
3790 R$ = LTRIM$(RTRIM$(R$))
3800 IF LEN(R$) < 2 THEN RETURN
3810 U1 = ASC(MID$(R$, 1, 1))
3820 U2 = ASC(MID$(R$, 2, 1))
3830 L = 0
3840 IF U1 <> 68 THEN GOTO 3880
3850 IF U2 <> 66 THEN GOTO 3860
3852 IF LEN(R$) = 2 THEN L = 1: GOTO 3880
3854 IF MID$(R$, 3, 1) = " " THEN L = 1: GOTO 3880
3860 IF U2 <> 87 THEN GOTO 3880
3862 IF LEN(R$) = 2 THEN L = 1: GOTO 3880
3864 IF MID$(R$, 3, 1) = " " THEN L = 1
3870 GOTO 3880
3880 IF LEN(R$) < 5 THEN GOTO 3970
3890 IF U1 <> 84 THEN GOTO 3970
3900 IF U2 <> 73 THEN GOTO 3970
3910 U3 = ASC(MID$(R$, 3, 1))
3920 IF U3 <> 77 THEN GOTO 3970
3930 U4 = ASC(MID$(R$, 4, 1))
3940 IF U4 <> 69 THEN GOTO 3970
3950 U5 = ASC(MID$(R$, 5, 1))
3960 IF U5 <> 83 THEN GOTO 3970
3962 IF LEN(R$) = 5 THEN L = 1: GOTO 3970
3964 IF MID$(R$, 6, 1) = " " THEN L = 1
3970 IF L = 0 THEN RETURN
3980 B$ = R$
3990 IF PASS <> 1 THEN GOTO 4052
4000 GOSUB 3390
4010 IF K = 0 THEN GOTO 4020
4012 IF SA(K) <> CP THEN CHG = 1
4014 SA(K) = CP
4016 RETURN
4020 IF SCNT >= 8700 THEN GOSUB 20640: RETURN
4030 SCNT = SCNT + 1
4040 SYI = SCNT: SYM$ = C$: GOSUB 19200
4041 IF ERR <> 0 THEN RETURN
4042 SLN(SCNT) = LEN(C$): SFC(SCNT) = ASC(LEFT$(C$,1)): SLC(SCNT) = ASC(RIGHT$(C$,1))
4043 SA(SCNT) = CP
4044 IF C$ = "NV" THEN KNV = SCNT
4045 IF C$ = "SV" THEN KSV = SCNT
4046 IF C$ = "START" THEN KSTART = SCNT
4047 IF C$ = "ENDPROG" THEN KENDPROG = SCNT
4048 IF C$ = "RT_EXIT" THEN KRTEXIT = SCNT
4051 CHG = 1: GOSUB 16600: RETURN
4052 GOSUB 3390
4054 IF K = 0 THEN ERR = 1: PRINT "ERROR: PASS2 UNKNOWN LABEL "; C$: RETURN
4056 IF SA(K) <> CP THEN ERR = 1: PRINT "ERROR: PASS2 LABEL ADDRESS "; C$; " "; SA(K); " "; CP: RETURN
4058 RETURN
4060 RETURN
4070 REM ==============================================================
4080 REM PASS1: INSTRUCTION LENGTH
4090 REM Result: K = length in bytes
4100 REM ==============================================================
4110 K = 0
4120 IF LEFT$(B$, 4) = "ORG " THEN K = 0: RETURN
4130 IF LEFT$(B$, 5) = "BITS " THEN K = 0: RETURN
4140 IF LEFT$(B$, 3) = "DB " THEN C$ = MID$(B$, 4, LEN(B$) - 3): EM = 0: GOSUB 5620: RETURN
4150 IF LEFT$(B$, 3) = "DW " THEN C$ = MID$(B$, 4, LEN(B$) - 3): EM = 0: GOSUB 6090: RETURN
4160 IF LEFT$(B$, 6) = "TIMES " THEN EM = 0: GOSUB 6370: RETURN
4180 IF B$ = "CLD" THEN K = 1: RETURN
4190 IF B$ = "RET" THEN K = 1: RETURN
4200 IF LEFT$(B$, 4) = "INT " THEN K = 2: RETURN
4210 IF LEFT$(B$, 4) = "JMP " THEN GOSUB 16210: RETURN
4220 IF LEFT$(B$, 5) = "CALL " THEN K = 3: RETURN
4230 IF LEFT$(B$, 5) = "PUSH " THEN K = 1: RETURN
4240 IF LEFT$(B$, 4) = "POP " THEN K = 1: RETURN
4250 IF LEFT$(B$, 4) = "INC " THEN GOSUB 12550: RETURN
4260 IF LEFT$(B$, 4) = "XOR " THEN K = 2: RETURN
4270 IF LEFT$(B$, 4) = "MOV " THEN GOSUB 4510: RETURN
4280 IF LEFT$(B$, 1) = "J" THEN GOSUB 17000: RETURN
4285 IF LEFT$(B$, 5) = "LOOP " THEN K = 2: RETURN
4290 IF B$ = "CLI" THEN K = 1: RETURN
4300 IF B$ = "STI" THEN K = 1: RETURN
4310 IF B$ = "LODSB" THEN K = 1: RETURN
4320 IF B$ = "STOSB" THEN K = 1: RETURN
4325 IF B$ = "STOSW" THEN K = 1: RETURN
4330 IF B$ = "MOVSB" THEN K = 1: RETURN
4340 IF B$ = "CMPSB" THEN K = 1: RETURN
4350 IF B$ = "REP MOVSB" THEN K = 2: RETURN
4355 IF B$ = "REP STOSB" THEN K = 2: RETURN
4356 IF B$ = "REP STOSW" THEN K = 2: RETURN
4360 IF B$ = "REPE CMPSB" THEN K = 2: RETURN
4370 IF LEFT$(B$, 4) = "CMP " THEN GOSUB 12090: RETURN
4380 IF LEFT$(B$, 4) = "ADD " THEN GOSUB 12380: RETURN
4390 IF LEFT$(B$, 4) = "SUB " THEN GOSUB 12380: RETURN
