19030 IF D2 <> 0 THEN PRINT "   ";: PRINT D2;: GOTO 19080
19040 PRINT "    ";: PRINT D1;: RETURN
19050 PRINT D4;
19060 PRINT D3;
19070 PRINT D2;
19080 PRINT D1;
19090 RETURN
19100 REM ==============================================================
19110 REM SYMBOL NAME GET, 8700 NAMES, 20 CHARS EACH
19120 REM Input : SYI  = symbol index 1..8700
19130 REM Output: SYM$ = symbol name
19140 REM ==============================================================
19150 IF SYI < 1 THEN ERR = 1: PRINT "ERROR: SYMGET INDEX LOW "; SYI: RETURN
19160 IF SYI > 2900 THEN GOTO 19170
19162 SYM$ = XGET$(SN1,SYI)
19164 RETURN
19170 IF SYI > 5800 THEN GOTO 19180
19172 SXI = SYI - 2900
19174 SYM$ = XGET$(SN2,SXI)
19176 RETURN
19180 IF SYI > 8700 THEN GOTO 19190
19182 SXI = SYI - 5800
19184 SYM$ = XGET$(SN3,SXI)
19186 RETURN
19190 ERR = 1: PRINT "ERROR: SYMGET INDEX HIGH "; SYI: RETURN
19200 REM ==============================================================
19210 REM SYMBOL NAME SET, 8700 NAMES, 20 CHARS EACH
19220 REM Input : SYI  = symbol index 1..8700
19230 REM         SYM$ = symbol name
19240 REM ==============================================================
19250 IF SYI < 1 THEN ERR = 1: PRINT "ERROR: SYMSET INDEX LOW "; SYI: RETURN
19260 IF SYI > 2900 THEN GOTO 19270
19262 XSET SN1,SYI,SYM$
19264 RETURN
19270 IF SYI > 5800 THEN GOTO 19280
19272 SXI = SYI - 2900
19274 XSET SN2,SXI,SYM$
19276 RETURN
19280 IF SYI > 8700 THEN GOTO 19290
19282 SXI = SYI - 5800
19284 XSET SN3,SXI,SYM$
19286 RETURN
19290 ERR = 1: PRINT "ERROR: SYMSET INDEX HIGH "; SYI: RETURN
19300 REM ==============================================================
19310 REM PASS1 BUILD COMPACT TABLES
19320 REM Reads F$ once; stores only real code/data lines
19330 REM Labels are stored separately with anchor to next P1 line
19340 REM ==============================================================
19350 P1CNT = 0
19360 JCNT = 0
19370 LCNT = 0
19375 P1MDB = 0
19380 CP = 256
19390 CHG = 0
19400 OPEN F$ FOR INPUT AS #1
19410 IF EOF(1) <> 0 THEN GOTO 19675
19420 LINE INPUT #1, B$
19430 IF LEN(B$) = 0 THEN GOTO 19410
19440 IF LEFT$(B$, 3) = "DB " THEN GOTO 19666
19445 OL$ = B$
19450 GOSUB 3460
19460 IF ERR <> 0 THEN PRINT "ERROR PASS1 LABEL: "; B$: CLOSE #1: RETURN
19470 REM ---- If a label was removed, store it with anchor P1CNT+1
19480 IF B$ = OL$ THEN GOTO 19550
19490 IF LEN(C$) = 0 THEN GOTO 19550
19500 SAVK = K
19510 GOSUB 3390
19520 IF K = 0 THEN GOTO 19540
19525 LCNT = LCNT + 1
19526 IF LCNT > LMAX THEN ERR = 1: PRINT "ERROR: PASS1 LABEL TABLE FULL": CLOSE #1: RETURN
19527 LI(LCNT) = K
19528 LA(LCNT) = P1CNT + 1
19529 P1MDB = 0
19540 K = SAVK
19550 REM ---- Pure label line: no P1 entry
19560 IF LEN(B$) = 0 THEN GOTO 19410
19570 REM ---- Real code/data line starts here
19572 IF LEFT$(B$, 3) = "DB " THEN GOTO 19666
19580 P1CNT = P1CNT + 1
19590 IF P1CNT > P1MAX THEN ERR = 1: PRINT "ERROR: PASS1 LINE TABLE FULL": CLOSE #1: RETURN
19600 P1A(P1CNT) = CP
19610 GOSUB 19680
19620 IF ERR <> 0 THEN CLOSE #1: RETURN
19630 GOSUB 4070
19640 IF ERR <> 0 THEN PRINT "ERROR PASS1 LINE: "; B$: CLOSE #1: RETURN
19650 P1K(P1CNT) = K
19655 P1MDB = 0
19660 CP = CP + K
19665 GOTO 19410
19666 GOSUB 20720
19667 IF DBF = 0 THEN GOSUB 4070
19668 IF ERR <> 0 THEN PRINT "ERROR PASS1 LINE: "; B$: CLOSE #1: RETURN
19669 IF P1MDB = 0 THEN GOTO 19672
19671 IF P1K(P1CNT) < 30000 THEN P1K(P1CNT) = P1K(P1CNT) + K: CP = CP + K: GOTO 19410
19672 P1CNT = P1CNT + 1
19673 IF P1CNT > P1MAX THEN ERR = 1: PRINT "ERROR: PASS1 LINE TABLE FULL": CLOSE #1: RETURN
19674 P1A(P1CNT) = CP: P1K(P1CNT) = K: CP = CP + K: P1MDB = 1: GOTO 19410
19675 CLOSE #1
19676 RETURN
19680 REM ==============================================================
19690 REM PASS1 COLLECT RELAXABLE JUMPS
19700 REM JLN positive = Jcc line, negative = JMP line
19710 REM ==============================================================
19720 IF LEFT$(B$, 4) = "JMP " THEN GOTO 19750
19730 IF LEFT$(B$, 1) <> "J" THEN RETURN
19740 GOSUB 17200
19741 IF ERR <> 0 THEN RETURN
19742 JT = 1
19743 GOTO 19780
19750 IF RJMP = 0 THEN RETURN
19760 T$ = MID$(B$, 5, LEN(B$) - 4)
19770 T$ = LTRIM$(RTRIM$(T$))
19775 JT = 2
19780 IF LEN(T$) > 20 THEN ERR = 1: PRINT "ERROR: JUMP TARGET TOO LONG "; T$: RETURN
19790 JCNT = JCNT + 1
19800 IF JCNT > JMAX THEN ERR = 1: PRINT "ERROR: JUMP TABLE FULL": RETURN
19810 IF JT = 1 THEN JLN(JCNT) = P1CNT
19820 IF JT = 2 THEN JLN(JCNT) = 0 - P1CNT
19830 XSET JTN,JCNT,T$
19835 RETURN
19840 REM ==============================================================
19850 REM PASS1 RESOLVE JUMP TARGETS
19860 REM ==============================================================
19870 I = 1
19880 IF I > JCNT THEN RETURN
19885 JI = I
19890 C$ = XGET$(JTN,JI)
19900 GOSUB 3390
19910 IF K = 0 THEN ERR = 1: PRINT "ERROR: UNKNOWN JUMP TARGET "; C$: RETURN
19920 JTG(JI) = K
19930 I = JI + 1
19940 GOTO 19880
19950 REM ==============================================================
19960 REM PASS1 RELAX FROM COMPACT TABLES
19970 REM Recomputes P1 addresses, updates label anchors, checks jumps
19980 REM ==============================================================
19990 P1ITER = 0
20000 P1ITER = P1ITER + 1
20010 IF P1ITER > 2048 THEN ERR = 1: PRINT "ERROR: PASS1 RELAXATION ITER "; P1ITER; " CP "; CP: RETURN
20020 CHG = 0
20030 CP = 256
20040 I = 1
20050 IF I > P1CNT THEN GOTO 20120
20060 P1A(I) = CP
20070 CP = CP + P1K(I)
20080 I = I + 1
20090 GOTO 20050
20120 REM ---- Update labels from label-anchor table
20130 I = 1
20140 IF I > LCNT THEN GOTO 20240
20150 AI = LA(I)
20155 IF AI < 1 THEN ERR = 1: PRINT "ERROR: LABEL ANCHOR LOW "; AI; " I "; I: RETURN
20160 IF AI > P1CNT THEN GOTO 20190
20165 IF AI > P1MAX THEN ERR = 1: PRINT "ERROR: LABEL ANCHOR HIGH "; AI; " I "; I: RETURN
20170 NA = P1A(AI)
20180 GOTO 20200
20190 NA = CP
20200 LK = LI(I)
20201 IF LK < 1 THEN ERR = 1: PRINT "ERROR: LABEL SYMBOL LOW "; LK; " I "; I: RETURN
20202 IF LK > SCNT THEN ERR = 1: PRINT "ERROR: LABEL SYMBOL HIGH "; LK; " SCNT "; SCNT; " I "; I: RETURN
20203 IF SA(LK) = NA THEN GOTO 20220
20210 SA(LK) = NA: CHG = 1
20220 I = I + 1
20230 GOTO 20140
20240 GOSUB 20300
20250 IF ERR <> 0 THEN RETURN
20260 IF CHG <> 0 THEN GOTO 20000
20270 RETURN
20300 REM ==============================================================
20310 REM PASS1 CHECK JUMP LENGTHS
20320 REM ==============================================================
20330 JI = 1
20340 IF JI > JCNT THEN RETURN
20350 LN = JLN(JI)
20360 JT = 1
20370 IF LN >= 0 THEN GOTO 20400
20380 LN = 0 - LN
20390 JT = 2
20400 JK = JTG(JI)
20402 IF LN < 1 THEN ERR = 1: PRINT "ERROR: JUMP LINE LOW "; LN; " JI "; JI: RETURN
20404 IF LN > P1CNT THEN ERR = 1: PRINT "ERROR: JUMP LINE HIGH "; LN; " P1 "; P1CNT; " JI "; JI: RETURN
20406 IF JK < 1 THEN ERR = 1: PRINT "ERROR: JUMP TARGET LOW "; JK; " JI "; JI: RETURN
20408 IF JK > SCNT THEN ERR = 1: PRINT "ERROR: JUMP TARGET HIGH "; JK; " SCNT "; SCNT; " JI "; JI: RETURN
20410 TV = SA(JK)
20420 IF JT = 2 THEN GOTO 20470
20430 REL = TV - (P1A(LN) + 2)
20440 NK = 2
20450 IF REL < -128 THEN NK = 5
20460 IF REL > 127 THEN NK = 5
20465 GOTO 20520
20470 REL = TV - (P1A(LN) + 2)
20490 NK = 2
20500 IF REL < -128 THEN NK = 3
20510 IF REL > 127 THEN NK = 3
20520 IF NK = P1K(LN) THEN GOTO 20550
20530 P1K(LN) = NK
20540 CHG = 1
20550 JI = JI + 1
20560 GOTO 20340
20600 REM ---- COMMON ERROR: ALIAS TABLE FULL
20610 ERR = 1
20620 PRINT "ERROR: ALIAS TABLE FULL"
20630 RETURN
20640 REM ---- COMMON ERROR: SYMBOL TABLE FULL
20650 ERR = 1
20660 PRINT "ERROR: SYMBOL TABLE FULL"
20670 RETURN
20680 REM ---- COMMON ERROR: IFDEF STACK FULL
20690 ERR = 1
20700 PRINT "ERROR: IFDEF STACK FULL"
20710 RETURN
20720 REM ---- PASS1 FAST SIMPLE DECIMAL DB
20730 DBF = 0
20740 C$ = MID$(B$, 4, LEN(B$) - 3)
20750 C$ = LTRIM$(RTRIM$(C$))
20760 IF LEN(C$) = 0 THEN RETURN
20770 I = 1
20780 IF I > LEN(C$) THEN K = 1: DBF = 1: RETURN
20790 CH = ASC(MID$(C$, I, 1))
