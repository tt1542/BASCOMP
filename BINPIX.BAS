7000 REM Photo of current overview including selection rectangle
7010 GOSUB 1120
7020 Y = 0
7030 X = 0
7040 C = -1
7050 IF Y <> ZY THEN GOTO 7080
7060 IF X < ZX THEN GOTO 7080
7070 IF X < ZX + ZW THEN C = 15: GOTO 7160
7080 IF Y <> ZY + ZH - 1 THEN GOTO 7110
7090 IF X < ZX THEN GOTO 7110
7100 IF X < ZX + ZW THEN C = 15: GOTO 7160
7110 IF X <> ZX THEN GOTO 7130
7120 IF Y < ZY THEN GOTO 7130
7125 IF Y < ZY + ZH THEN C = 15: GOTO 7160
7130 IF X <> ZX + ZW - 1 THEN GOTO 7150
7140 IF Y < ZY THEN GOTO 7150
7145 IF Y < ZY + ZH THEN C = 15: GOTO 7160
