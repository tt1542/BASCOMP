10 REM ============================================
20 REM BINPIX.BAS - Binary file as colored pixels
30 REM Requires SCREEN/PSET, GET, PUT, OPEN, INKEY$
40 REM SCREEN 13 = 320x200, 256 colors
50 REM One byte = one pixel, one page = 64000 bytes
60 REM Interactive: arrows select, ENTER zoom, N/P page, F photo, ESC back/exit
65 REM F writes current view as BPIXnnnn.PPM
70 REM ============================================
80 P$ = LTRIM$(RTRIM$(COMMAND$))
85 P$ = UCASE$(P$)
86 F$ = ""
90 IF LEN(P$) = 0 THEN GOTO 98
91 GOSUB 1000
92 IF LEN(F$) = 0 THEN GOTO 98
93 GOSUB 1090
94 IF EXIST(F$) <> 0 THEN GOTO 100
95 PRINT "FILE?"
96 INPUT F$
97 GOTO 100
98 PRINT "FILE?"
99 INPUT F$
100 OPEN F$ FOR INPUT AS #1
105 DIM P0(32000)
106 DIM P1(32000)
107 DIM FT(665)
110 PAGE = 0
115 OF = 0
116 PN = 0
117 DONE = 0
118 ZW = 40: ZH = 24: ZX = 0: ZY = 0: MD = 0
119 GOSUB 5600: GOSUB 1800
120 SCREEN 13
125 COLOR 7,0
126 CLS
127 GOSUB 2000
128 GOSUB 3000
129 GOTO 4000
500 REM Semantic color coding and plot current byte B at X,Y
510 GOSUB 540
520 PSET X, Y, C
530 RETURN
540 REM Semantic color coding only, result in C
545 REM 0 black, FF white, control red, whitespace cyan/gray, text green/yellow/cyan, high bytes blue
550 IF B = 0 THEN C = 0: RETURN
560 IF B = 255 THEN C = 15: RETURN
570 IF B = 9 THEN C = 11: RETURN
580 IF B = 10 THEN C = 11: RETURN
590 IF B = 13 THEN C = 11: RETURN
600 IF B = 32 THEN C = 8: RETURN
610 IF B < 32 THEN C = 4: RETURN
620 IF B = 127 THEN C = 13: RETURN
630 IF B > 127 THEN C = 9: RETURN
640 IF B < 48 THEN GOTO 680
650 IF B <= 57 THEN C = 14: RETURN
660 IF B < 65 THEN GOTO 680
670 IF B <= 90 THEN C = 10: RETURN
672 IF B < 97 THEN GOTO 680
674 IF B <= 122 THEN C = 10: RETURN
680 C = 11
690 RETURN
900 SCREEN 0
910 COLOR 7, 0
920 CLS
925 IF OF <> 0 THEN CLOSE #2
930 CLOSE #1
940 PRINT "DONE."
950 END
1000 REM Parse command line P$: /P or /PPM are accepted but ignored
1010 P$ = LTRIM$(RTRIM$(P$))
1020 IF LEN(P$) = 0 THEN RETURN
1030 I = INSTR(P$, " ")
1040 IF I = 0 THEN T$ = P$: P$ = "": GOTO 1060
1050 T$ = LEFT$(P$, I - 1): P$ = MID$(P$, I + 1, LEN(P$) - I)
1060 IF T$ = "/P" THEN GOTO 1010
1062 IF T$ = "-P" THEN GOTO 1010
1064 IF T$ = "/PPM" THEN GOTO 1010
1066 IF T$ = "-PPM" THEN GOTO 1010
1070 IF LEN(F$) = 0 THEN F$ = T$
1080 GOTO 1010
1090 REM Append .COM to command line filename if no extension is present
1092 I = LEN(F$): J = 0
1094 IF I <= 0 THEN GOTO 1112
1096 C$ = MID$(F$, I, 1)
1098 IF C$ = "." THEN J = I: GOTO 1112
1100 IF C$ = "\" THEN GOTO 1112
1102 IF C$ = ":" THEN GOTO 1112
1104 I = I - 1: GOTO 1094
1112 IF J <> 0 THEN RETURN
1114 F$ = F$ + ".COM"
1116 RETURN
1120 REM Open binary PPM/P6 export using next free BPIXnnnn.PPM name
1125 GOSUB 1520
1130 IF EXIST(O$) = 0 THEN GOTO 1140
1135 PN = PN + 1: GOTO 1125
1140 OPEN O$ FOR OUTPUT AS #2
1150 B = 80: GOSUB 1500
1152 B = 54: GOSUB 1500
1154 B = 10: GOSUB 1500
1156 B = 51: GOSUB 1500
1158 B = 50: GOSUB 1500
1160 B = 48: GOSUB 1500
1162 B = 32: GOSUB 1500
1164 B = 50: GOSUB 1500
1166 B = 48: GOSUB 1500
1168 B = 48: GOSUB 1500
1170 B = 10: GOSUB 1500
1172 B = 50: GOSUB 1500
1174 B = 53: GOSUB 1500
1176 B = 53: GOSUB 1500
1178 B = 10: GOSUB 1500
1180 OF = 1
1185 PN = PN + 1
1190 RETURN
1220 REM Write current semantic color C as binary RGB triple
1230 IF C = 0 THEN R = 0: G = 0: H = 0: GOTO 1330
1240 IF C = 4 THEN R = 255: G = 0: H = 0: GOTO 1330
1250 IF C = 8 THEN R = 80: G = 80: H = 80: GOTO 1330
1260 IF C = 9 THEN R = 0: G = 0: H = 255: GOTO 1330
1270 IF C = 10 THEN R = 0: G = 255: H = 0: GOTO 1330
1280 IF C = 11 THEN R = 0: G = 255: H = 255: GOTO 1330
1290 IF C = 13 THEN R = 255: G = 0: H = 255: GOTO 1330
1300 IF C = 14 THEN R = 255: G = 255: H = 0: GOTO 1330
1310 IF C = 15 THEN R = 255: G = 255: H = 255: GOTO 1330
1320 R = 128: G = 128: H = 128
1330 PUT #2, R
1340 PUT #2, G
1345 PUT #2, H
1348 RETURN
1500 PUT #2, B
1510 RETURN
1520 REM Build O$ = BPIXnnnn.PPM from PN
1530 O$ = RIGHT$("0000" + LTRIM$(STR$(PN)), 4)
1540 O$ = "BPIX" + O$ + ".PPM"
1550 RETURN
1800 REM Startup help before SCREEN 13
1810 CLS
1820 PRINT "BINPIX - BINARY FILE AS COLORED PIXELS"
1830 PRINT
1840 PRINT "ONE SCREEN PAGE = 320 X 200 = 64000 BYTES."
1850 PRINT
1860 PRINT "OVERVIEW:"
1870 PRINT "  ARROW KEYS   MOVE SELECTION RECTANGLE"
1880 PRINT "  ENTER/SPACE  OPEN ZOOM VIEW"
1890 PRINT "  N            NEXT 64000-BYTE PAGE"
1900 PRINT "  P            PREVIOUS 64000-BYTE PAGE"
1910 PRINT "  F            SAVE CURRENT VIEW AS BPIXNNNN.PPM"
1920 PRINT "  ESC          EXIT PROGRAM"
1930 PRINT
1940 PRINT "ZOOM:"
1950 PRINT "  ARROW KEYS   MOVE ZOOM REGION"
1960 PRINT "  F            SAVE ZOOM VIEW AS BPIXNNNN.PPM"
1970 PRINT "  ESC          RETURN TO OVERVIEW"
1980 PRINT
1990 PRINT "PRINTABLE ASCII BYTES ARE SHOWN AS TEXT IN ZOOM."
1992 PRINT
1994 PRINT "PRESS ENTER TO START..."
1996 K$ = INKEY$
1998 IF K$ <> CHR$(13) THEN GOTO 1996
1999 RETURN
2000 REM Load one 64000-byte screen page into P0/P1 and draw overview
2010 CLS
2020 X = 0
2030 Y = 0
2040 DONE = 0
2050 IF EOF(1) <> 0 THEN DONE = 1: GOTO 2200
2060 GET #1, B
2070 GOSUB 2500
2080 GOSUB 500
2090 X = X + 1
2100 IF X < 320 THEN GOTO 2050
2110 X = 0
2120 Y = Y + 1
2130 IF Y < 200 THEN GOTO 2050
2140 IF EOF(1) <> 0 THEN DONE = 1
2150 RETURN
2200 REM Fill remainder of incomplete page with black zero bytes
2210 IF Y >= 200 THEN RETURN
2220 B = 0
2230 GOSUB 2500
2240 C = 0
2250 PSET X, Y, C
2260 X = X + 1
2270 IF X < 320 THEN GOTO 2210
2280 X = 0
2290 Y = Y + 1
2300 GOTO 2210
2500 REM Store B at visible position X,Y into page buffer
2510 IF Y < 100 THEN I = Y * 320 + X + 1: P0(I) = B: RETURN
2520 I = (Y - 100) * 320 + X + 1
2530 P1(I) = B
2540 RETURN
2600 REM Load B from page buffer at visible position X,Y
2610 IF Y < 100 THEN I = Y * 320 + X + 1: B = P0(I): RETURN
2620 I = (Y - 100) * 320 + X + 1
2630 B = P1(I)
2640 RETURN
3000 REM Redraw full overview from page buffer without selection rectangle
3010 CLS
3020 Y = 0
3030 X = 0
3040 GOSUB 2600
3050 GOSUB 500
3060 X = X + 1
3070 IF X < 320 THEN GOTO 3040
3080 X = 0
3090 Y = Y + 1
3100 IF Y < 200 THEN GOTO 3040
3110 RETURN
3300 REM Draw selection rectangle in overview
3310 XX = ZX
3320 IF XX >= ZX + ZW THEN GOTO 3360
3330 PSET XX, ZY, 15
3340 PSET XX, ZY + ZH - 1, 15
3350 XX = XX + 1: GOTO 3320
3360 YY = ZY
3370 IF YY >= ZY + ZH THEN RETURN
3380 PSET ZX, YY, 15
3390 PSET ZX + ZW - 1, YY, 15
3400 YY = YY + 1: GOTO 3370
3450 REM Restore old selection rectangle from buffer
3460 XX = ZX
3470 IF XX >= ZX + ZW THEN GOTO 3520
3480 X = XX: Y = ZY: GOSUB 2600: GOSUB 500
3490 X = XX: Y = ZY + ZH - 1: GOSUB 2600: GOSUB 500
3500 XX = XX + 1
3510 GOTO 3470
3520 YY = ZY
3530 IF YY >= ZY + ZH THEN RETURN
3540 X = ZX: Y = YY: GOSUB 2600: GOSUB 500
3550 X = ZX + ZW - 1: Y = YY: GOSUB 2600: GOSUB 500
3560 YY = YY + 1
3570 GOTO 3530
4000 REM Overview interaction loop
4010 MD = 0
4020 GOSUB 3300
4030 K$ = INKEY$
4040 IF K$ = "" THEN GOTO 4030
4050 IF K$ = CHR$(27) THEN GOTO 900
4060 IF LEN(K$) = 2 THEN GOSUB 4200: GOTO 4030
4070 IF LEN(K$) <> 1 THEN GOTO 4030
4080 KC = ASC(K$)
4090 IF KC = 13 THEN GOSUB 5000: GOSUB 3000: GOTO 4000
4092 IF KC = 32 THEN GOSUB 5000: GOSUB 3000: GOTO 4000
4100 IF KC = 70 THEN GOSUB 7000: GOTO 4000
4102 IF KC = 102 THEN GOSUB 7000: GOTO 4000
4110 IF KC = 78 THEN GOSUB 4500: GOTO 4000
4112 IF KC = 110 THEN GOSUB 4500: GOTO 4000
4120 IF KC = 80 THEN GOSUB 4600: GOTO 4000
4122 IF KC = 112 THEN GOSUB 4600: GOTO 4000
4130 GOTO 4030
4200 REM Move selection rectangle by cursor scan code
4210 K2 = ASC(RIGHT$(K$, 1))
4220 IF K2 = 75 THEN GOSUB 3450: ZX = ZX - 1: GOTO 4300
4230 IF K2 = 77 THEN GOSUB 3450: ZX = ZX + 1: GOTO 4300
4240 IF K2 = 72 THEN GOSUB 3450: ZY = ZY - 1: GOTO 4300
4250 IF K2 = 80 THEN GOSUB 3450: ZY = ZY + 1: GOTO 4300
4260 RETURN
4300 REM Clamp and redraw selection rectangle
4310 IF ZX < 0 THEN ZX = 0
4320 IF ZY < 0 THEN ZY = 0
4330 IF ZX > 320 - ZW THEN ZX = 320 - ZW
4340 IF ZY > 200 - ZH THEN ZY = 200 - ZH
4350 GOSUB 3300
4360 RETURN
4500 REM Next 64000-byte page
4510 IF DONE <> 0 THEN RETURN
4520 PAGE = PAGE + 1
4530 GOSUB 2000
4540 GOSUB 3000
4550 RETURN
4600 REM Previous 64000-byte page by reopen and skip
4610 IF PAGE <= 0 THEN RETURN
4620 PAGE = PAGE - 1
4630 GOSUB 4700
4640 GOSUB 2000
4650 GOSUB 3000
4660 RETURN
4700 REM Reopen file and skip PAGE complete 64000-byte pages
4710 CLOSE #1
4720 OPEN F$ FOR INPUT AS #1
4730 SP = PAGE
4740 IF SP <= 0 THEN RETURN
4750 GOSUB 4800
4760 SP = SP - 1
4770 GOTO 4740
4800 REM Skip exactly one 64000-byte page: 32000 + 32000 bytes
4810 S = 0
4820 IF S >= 32000 THEN GOTO 4870
4830 IF EOF(1) <> 0 THEN RETURN
4840 GET #1, B
4850 S = S + 1
4860 GOTO 4820
4870 S = 0
4880 IF S >= 32000 THEN RETURN
4890 IF EOF(1) <> 0 THEN RETURN
4900 GET #1, B
4910 S = S + 1
4920 GOTO 4880
5000 REM Zoom interaction loop
5010 MD = 1
5020 GOSUB 5100
5030 K$ = INKEY$
5040 IF K$ = "" THEN GOTO 5030
5050 IF K$ = CHR$(27) THEN MD = 0: RETURN
5060 IF LEN(K$) = 2 THEN GOSUB 5400: GOTO 5020
5070 IF LEN(K$) <> 1 THEN GOTO 5030
5080 KC = ASC(K$)
5090 IF KC = 70 THEN GOSUB 7200: GOTO 5020
5092 IF KC = 102 THEN GOSUB 7200: GOTO 5020
5094 IF KC = 13 THEN MD = 0: RETURN
5096 IF KC = 32 THEN MD = 0: RETURN
5098 GOTO 5030
5100 REM Draw zoomed 40x24 byte region, 8x8 pixels per byte
5110 CLS
5120 YY = 0
5130 IF YY >= ZH THEN GOTO 5280
5140 XX = 0
5150 IF XX >= ZW THEN GOTO 5260
5160 X = ZX + XX
5170 Y = ZY + YY
5180 GOSUB 2600
5190 GOSUB 540
5200 X0 = XX * 8
5210 Y0 = YY * 8
5220 GOSUB 5300
5230 IF B < 32 THEN GOTO 5250
5235 IF B > 126 THEN GOTO 5250
5237 IF B = 32 THEN GOTO 5250
5240 GOSUB 5700
5250 XX = XX + 1: GOTO 5150
5260 YY = YY + 1
5270 GOTO 5130
5280 COLOR 15, 0
5282 LOCATE 25, 1
5284 PRINT "PAGE "; PAGE; " X="; ZX; " Y="; ZY; " ESC=BACK F=PHOTO";
5288 RETURN
5300 REM Draw one 8x8 color block at X0,Y0 using C
5310 PY = 0
5320 IF PY >= 8 THEN RETURN
5330 PX = 0
5340 IF PX >= 8 THEN GOTO 5380
5350 PSET X0 + PX, Y0 + PY, C
5360 PX = PX + 1
5370 GOTO 5340
5380 PY = PY + 1
5390 GOTO 5320
5400 REM Move zoom region by cursor scan code
5410 K2 = ASC(RIGHT$(K$, 1))
5420 IF K2 = 75 THEN ZX = ZX - 1: GOTO 5500
5430 IF K2 = 77 THEN ZX = ZX + 1: GOTO 5500
5440 IF K2 = 72 THEN ZY = ZY - 1: GOTO 5500
5450 IF K2 = 80 THEN ZY = ZY + 1: GOTO 5500
5460 RETURN
5500 REM Clamp zoom region
5510 IF ZX < 0 THEN ZX = 0
5520 IF ZY < 0 THEN ZY = 0
5530 IF ZX > 320 - ZW THEN ZX = 320 - ZW
5540 IF ZY > 200 - ZH THEN ZY = 200 - ZH
5550 RETURN
5600 REM Load 5x7 font table FT(1..665), ASCII 32..126
5610 FI = 1
5620 IF FI > 665 THEN RETURN
5630 READ FV
5635 FT(FI) = FV
5640 FI = FI + 1
5650 GOTO 5620
5700 REM Draw 5x7 glyph for byte B at X0,Y0 without clearing background
5710 FI = (B - 32) * 7 + 1
5720 TC = 15
5730 IF C = 14 THEN TC = 0
5740 IF C = 15 THEN TC = 0
5750 IF C = 11 THEN TC = 0
5760 RY = 0
5770 IF RY >= 7 THEN RETURN
5780 RM = FT(FI + RY)
5790 RX = 0
5800 BM = 16
5810 IF RX >= 5 THEN GOTO 5880
5820 IF RM < BM THEN GOTO 5850
5830 PSET X0 + RX + 1, Y0 + RY, TC
5840 RM = RM - BM
5850 BM = BM \ 2
5860 RX = RX + 1
5870 GOTO 5810
5880 RY = RY + 1
5890 GOTO 5770
5900 REM Return FP=1 if zoom photo pixel GX,GY belongs to glyph for B
5910 FP = 0
5920 IF B < 33 THEN RETURN
5930 IF B > 126 THEN RETURN
5940 IF GX < 0 THEN RETURN
5950 IF GX > 4 THEN RETURN
5960 IF GY < 0 THEN RETURN
5970 IF GY > 6 THEN RETURN
5980 FI = (B - 32) * 7 + 1
5982 RM = FT(FI + GY)
5984 RX = 0
5986 BM = 16
5988 IF RX >= GX THEN GOTO 5997
5989 IF RM < BM THEN GOTO 5991
5990 RM = RM - BM
5991 BM = BM \ 2
5992 RX = RX + 1
5994 GOTO 5988
5997 IF RM < BM THEN RETURN
5998 FP = 1
5999 RETURN
