10 REM ============================================
20 REM BINPIX.BAS - Binary file as colored pixels
30 REM Requires SCREEN/PSET, GET, PUT, OPEN, INKEY$
40 REM SCREEN 13 = 320x200, 256 colors
50 REM One byte = one pixel
60 REM ESC exits, any other key loads next page
65 REM /P or /PPM exports each page as BPIXn.PPM
70 REM ============================================
80 P$ = LTRIM$(RTRIM$(COMMAND$))
85 P$ = UCASE$(P$)
86 F$ = "": XP = 0
90 IF LEN(P$) = 0 THEN GOTO 98
91 GOSUB 1000
92 IF LEN(F$) = 0 THEN GOTO 98
93 GOSUB 1090
94 IF EXIST(F$) <> 0 THEN GOTO 100
95 PRINT "FILE?"
96 INPUT F$
97 GOTO 100
98 PRINT "FILE?"
99 INPUT F$
100 OPEN F$ FOR INPUT AS #1
110 PAGE = 0
115 OF = 0
116 PN = 0
120 SCREEN 13
125 COLOR 7,0
126 CLS
130 X = 0
140 Y = 0
150 DONE = 0
155 IF EOF(1) <> 0 THEN DONE = 1: GOTO 300
160 GET #1, B
162 IF XP = 0 THEN GOTO 170
165 IF OF = 0 THEN GOSUB 1120
170 GOSUB 500
180 X = X + 1
190 IF X < 320 THEN GOTO 230
200 X = 0
210 Y = Y + 1
220 IF Y >= 200 THEN GOTO 300
230 K$ = INKEY$
240 IF K$ = CHR$(27) THEN GOTO 900
250 GOTO 155
300 IF OF <> 0 THEN GOSUB 1350: CLOSE #2: OF = 0
305 PAGE = PAGE + 1
310 K$ = INKEY$
320 IF K$ = "" THEN GOTO 310
330 IF K$ = CHR$(27) THEN GOTO 900
340 IF DONE <> 0 THEN GOTO 900
345 COLOR 7,0
350 CLS
360 GOTO 130
500 REM Semantic color coding
505 REM 0 black, FF white, control red, whitespace cyan/gray, text green/yellow/cyan, high bytes blue
510 IF B = 0 THEN C = 0: GOTO 680
520 IF B = 255 THEN C = 15: GOTO 680
530 IF B = 9 THEN C = 11: GOTO 680
540 IF B = 10 THEN C = 11: GOTO 680
550 IF B = 13 THEN C = 11: GOTO 680
560 IF B = 32 THEN C = 8: GOTO 680
570 IF B < 32 THEN C = 4: GOTO 680
580 IF B = 127 THEN C = 13: GOTO 680
590 IF B > 127 THEN C = 9: GOTO 680
600 IF B < 48 THEN GOTO 650
610 IF B <= 57 THEN C = 14: GOTO 680
620 IF B < 65 THEN GOTO 650
630 IF B <= 90 THEN C = 10: GOTO 680
640 IF B < 97 THEN GOTO 650
645 IF B <= 122 THEN C = 10: GOTO 680
650 C = 11
680 PSET X, Y, C
685 IF OF <> 0 THEN GOSUB 1220
690 RETURN
900 SCREEN 0
910 COLOR 7, 0
920 CLS
925 IF OF <> 0 THEN GOSUB 1350: CLOSE #2
930 CLOSE #1
940 PRINT "DONE."
950 END
1000 REM Parse command line P$: /P or /PPM enables PPM export
1010 P$ = LTRIM$(RTRIM$(P$))
1020 IF LEN(P$) = 0 THEN RETURN
1030 I = INSTR(P$, " ")
1040 IF I = 0 THEN T$ = P$: P$ = "": GOTO 1060
1050 T$ = LEFT$(P$, I - 1): P$ = MID$(P$, I + 1, LEN(P$) - I)
1060 IF T$ = "/P" THEN XP = 1: GOTO 1010
1062 IF T$ = "-P" THEN XP = 1: GOTO 1010
1064 IF T$ = "/PPM" THEN XP = 1: GOTO 1010
1066 IF T$ = "-PPM" THEN XP = 1: GOTO 1010
1070 IF LEN(F$) = 0 THEN F$ = T$
1080 GOTO 1010
1090 REM Append .COM to command line filename if no extension is present
1092 I = LEN(F$): J = 0
1094 IF I <= 0 THEN GOTO 1112
1096 C$ = MID$(F$, I, 1)
1098 IF C$ = "." THEN J = I: GOTO 1112
1100 IF C$ = "\" THEN GOTO 1112
1102 IF C$ = ":" THEN GOTO 1112
1104 I = I - 1: GOTO 1094
1112 IF J <> 0 THEN RETURN
1114 F$ = F$ + ".COM"
1116 RETURN
1120 REM Open binary PPM/P6 export using next free BPIXnnnn.PPM name
1125 GOSUB 1520
1130 IF EXIST(O$) = 0 THEN GOTO 1140
1135 PN = PN + 1: GOTO 1125
1140 OPEN O$ FOR OUTPUT AS #2
1150 B = 80: GOSUB 1500
1152 B = 54: GOSUB 1500
1154 B = 10: GOSUB 1500
1156 B = 51: GOSUB 1500
1158 B = 50: GOSUB 1500
1160 B = 48: GOSUB 1500
1162 B = 32: GOSUB 1500
1164 B = 50: GOSUB 1500
1166 B = 48: GOSUB 1500
1168 B = 48: GOSUB 1500
1170 B = 10: GOSUB 1500
1172 B = 50: GOSUB 1500
1174 B = 53: GOSUB 1500
1176 B = 53: GOSUB 1500
1178 B = 10: GOSUB 1500
1180 OF = 1
1185 PN = PN + 1
1190 RETURN

1220 REM Write current semantic color C as binary RGB triple
1230 IF C = 0 THEN R = 0: G = 0: H = 0: GOTO 1330
1240 IF C = 4 THEN R = 255: G = 0: H = 0: GOTO 1330
1250 IF C = 8 THEN R = 80: G = 80: H = 80: GOTO 1330
1260 IF C = 9 THEN R = 0: G = 0: H = 255: GOTO 1330
1270 IF C = 10 THEN R = 0: G = 255: H = 0: GOTO 1330
1280 IF C = 11 THEN R = 0: G = 255: H = 255: GOTO 1330
1290 IF C = 13 THEN R = 255: G = 0: H = 255: GOTO 1330
1300 IF C = 14 THEN R = 255: G = 255: H = 0: GOTO 1330
1310 IF C = 15 THEN R = 255: G = 255: H = 255: GOTO 1330
1320 R = 128: G = 128: H = 128
1330 PUT #2, R
1340 PUT #2, G
1345 PUT #2, H
1348 RETURN

1350 REM Pad incomplete page with black pixels so PPM remains valid
1360 IF OF = 0 THEN RETURN
1370 IF Y >= 200 THEN RETURN
1380 C = 0
1390 PSET X, Y, C
1400 GOSUB 1220
1410 X = X + 1
1420 IF X < 320 THEN GOTO 1370
1430 X = 0
1440 Y = Y + 1
1450 GOTO 1370

1500 PUT #2, B
1510 RETURN

1520 REM Build O$ = BPIXnnnn.PPM from PN
1530 O$ = RIGHT$("0000" + LTRIM$(STR$(PN)), 4)
1540 O$ = "BPIX" + O$ + ".PPM"
1550 RETURN