10 REM ==========================================================
20 REM RENBIG.BAS - NORMALIZE BASIC LINE NUMBERS
30 REM WITHOUT ARRAYS, MAPPING VIA TEMP FILE
40 REM NEW NUMBERS: 10,20,30,...
50 REM ADJUSTS GOTO/GOSUB TARGETS
60 REM ==========================================================
70 I$ = ""
80 O$ = ""
90 MAP$ = "RNUMMAP.TMP"
100 C$ = LTRIM$(RTRIM$(COMMAND$))
110 IF LEN(C$) = 0 THEN GOTO 200
120 P = INSTR(C$, " ")
130 IF P <> 0 THEN GOTO 160
140 I$ = C$
150 GOTO 200
160 I$ = LEFT$(C$, P - 1)
170 C$ = MID$(C$, P + 1, LEN(C$) - P)
180 C$ = LTRIM$(RTRIM$(C$))
190 O$ = C$
200 IF LEN(I$) <> 0 THEN GOTO 240
210 PRINT "BASIC SOURCE FILE"
220 INPUT I$
230 I$ = LTRIM$(RTRIM$(I$))
240 IF LEN(O$) <> 0 THEN GOTO 280
250 PRINT "BASIC TARGET FILE"
260 INPUT O$
270 O$ = LTRIM$(RTRIM$(O$))
280 IF LEN(I$) <> 0 THEN GOTO 290
281 PRINT "NO SOURCE FILE"
282 END
290 IF LEN(O$) <> 0 THEN GOTO 300
291 PRINT "NO TARGET FILE"
292 END
300 IF I$ <> O$ THEN GOTO 330
310 PRINT "SOURCE AND TARGET MUST NOT BE THE SAME"
320 END
330 GOSUB 500
340 GOSUB 700
350 PRINT "DONE. LINES: "; N
360 END

500 REM ==========================================================
510 REM PASS 1: CREATE MAPPING FILE
520 REM ==========================================================
530 N = 0
540 OPEN I$ FOR INPUT AS #1
550 OPEN MAP$ FOR OUTPUT AS #2
560 IF EOF(1) <> 0 THEN GOTO 650
570 LINE INPUT #1, A$
575 A$ = LTRIM$(RTRIM$(A$))
576 IF LEN(A$) = 0 THEN GOTO 560
580 GOSUB 1000
590 IF F <> 0 THEN GOTO 620
600 PRINT "MISSING LINE NUMBER: "; A$
610 CLOSE #1: CLOSE #2: END
620 N = N + 1
630 NN = N * 10
640 IF NN <= 32760 THEN GOTO 641
6401 PRINT "TOO MANY LINES FOR 10-STEP NUMBERS"
6402 CLOSE #1
6403 CLOSE #2
6404 END
641 VN = OLN: GOSUB 12000: OS$ = VS$
642 VN = NN: GOSUB 12000: NS$ = VS$
645 PRINT #2, OS$; "="; NS$
647 GOTO 560
650 CLOSE #1
660 CLOSE #2
670 RETURN

700 REM ==========================================================
710 REM PASS 2: REWRITE FILE
720 REM ==========================================================
730 OPEN I$ FOR INPUT AS #1
740 OPEN O$ FOR OUTPUT AS #2
750 N2 = 0
760 IF EOF(1) <> 0 THEN GOTO 850
770 LINE INPUT #1, A$
775 A$ = LTRIM$(RTRIM$(A$))
776 IF LEN(A$) = 0 THEN GOTO 760
780 GOSUB 1000
790 IF F <> 0 THEN GOTO 820
800 PRINT "MISSING LINE NUMBER IN PASS 2: "; A$
810 CLOSE #1: CLOSE #2: END
820 N2 = N2 + 1
830 NN = N2 * 10
835 R$ = MID$(A$, P, LEN(A$) - P + 1)
836 R$ = LTRIM$(R$)
840 VN = NN: GOSUB 12000
841 PRINT #2, VS$; " ";
842 GOSUB 1500
843 PRINT #2, ""
847 GOTO 760
850 CLOSE #1
860 CLOSE #2
870 KILL MAP$
880 RETURN

1000 REM ==========================================================
1010 REM READ LEADING LINE NUMBER
1020 REM Output: F=1, OLN=number, P=position after number
1030 REM ==========================================================
1040 F = 0
1050 OLN = 0
1060 P = 1
1070 IF P > LEN(A$) THEN RETURN
1080 MC = ASC(MID$(A$, P, 1))
1090 IF MC < 48 THEN RETURN
1100 IF MC > 57 THEN RETURN
1110 F = 1
1120 OLN = OLN * 10 + MC - 48
1130 P = P + 1
1140 GOTO 1070

1300 REM ==========================================================
1310 REM CHECK KEYWORD BOUNDARY
1320 REM INPUT: R$, SP, KP
1330 REM OUTPUT: BF=1 IF KEYWORD AT POSITION SP IS VALID
1340 REM ==========================================================
1350 BF = 0
1360 IF SP = 1 THEN GOTO 1410
1370 BC = ASC(MID$(R$, SP - 1, 1))
1380 IF BC >= 65 AND BC <= 90 THEN RETURN
1390 IF BC >= 48 AND BC <= 57 THEN RETURN
1400 IF BC = 95 OR BC = 36 THEN RETURN
1410 TP = SP + KP
1420 IF TP <= LEN(R$) THEN GOTO 1430
1421 BF = 1
1422 RETURN
1430 BC = ASC(MID$(R$, TP, 1))
1440 IF BC >= 65 AND BC <= 90 THEN RETURN
1450 IF BC = 95 OR BC = 36 THEN RETURN
1460 BF = 1
1470 RETURN

14000 REM ==========================================================
14010 REM SEARCH MAPPING: OLN -> NLN
14020 REM Output: F=1 found, F=0 not found
14030 REM ==========================================================
14040 F = 0
14050 NLN = OLN
14060 OPEN MAP$ FOR INPUT AS #3
14070 IF EOF(3) <> 0 THEN GOTO 14160
14080 LINE INPUT #3, M$
14090 EQ = INSTR(M$, "=")
14100 IF EQ = 0 THEN GOTO 14070
14110 X = VAL(LEFT$(M$, EQ - 1))
14120 IF X <> OLN THEN GOTO 14070
14130 NLN = VAL(MID$(M$, EQ + 1, LEN(M$) - EQ))
14140 F = 1
14150 CLOSE #3: RETURN
14160 CLOSE #3
14170 RETURN

1500 REM ==========================================================
1510 REM REWRITE REMAINING LINE R$
1520 REM ONLY GOTO/GOSUB TARGETS OUTSIDE STRINGS
1540 REM ==========================================================
1560 SP = 1
1570 SQ = 0
1580 IF SP > LEN(R$) THEN RETURN
1590 SC$ = MID$(R$, SP, 1)
1600 IF SC$ <> CHR$(34) THEN GOTO 1650
1610 IF SQ <> 0 THEN GOTO 1615
1611 SQ = 1
1612 GOTO 1620
1615 SQ = 0
1620 PRINT #2, SC$;
1630 SP = SP + 1
1640 GOTO 1580

1650 IF SQ <> 0 THEN GOTO 2200

1660 IF SP + 2 > LEN(R$) THEN GOTO 1760
1670 IF MID$(R$, SP, 3) <> "REM" THEN GOTO 1760
1680 KP = 3
1689 TB$ = T$
1690 GOSUB 1300
1691 T$ = TB$
1700 IF BF = 0 THEN GOTO 1760
1701 PRINT #2, MID$(R$, SP, LEN(R$) - SP + 1);
1702 RETURN

1760 IF SP + 4 > LEN(R$) THEN GOTO 1840
1770 IF MID$(R$, SP, 5) <> "GOSUB" THEN GOTO 1840
1780 KP = 5
1789 TB$ = T$
1790 GOSUB 1300
1791 T$ = TB$
1800 IF BF <> 0 THEN GOTO 2500

1840 IF SP + 3 > LEN(R$) THEN GOTO 2200
1850 IF MID$(R$, SP, 4) <> "GOTO" THEN GOTO 2200
1860 KP = 4
1869 TB$ = T$
1870 GOSUB 1300
1871 T$ = TB$
1880 IF BF <> 0 THEN GOTO 2500
1890 GOTO 2200

2200 REM ---- COPY NORMAL CHARACTER ----
2210 PRINT #2, SC$;
2220 SP = SP + 1
2230 GOTO 1580

2500 REM ==========================================================
2510 REM REWRITE GOTO/GOSUB TARGET OR TARGET LIST
2520 REM SP POINTS TO KEYWORD, KP = KEYWORD LENGTH
2530 REM ==========================================================
2540 PRINT #2, MID$(R$, SP, KP);
2550 NX = SP + KP

2560 REM ---- KEEP SPACES/TABS AFTER KEYWORD ----
2570 IF NX <= LEN(R$) THEN GOTO 2580
2571 SP = NX
2572 GOTO 1580
2580 SC$ = MID$(R$, NX, 1)
2590 IF SC$ <> " " THEN GOTO 2600
2591 PRINT #2, SC$;
2592 NX = NX + 1
2593 GOTO 2570
2600 SC = ASC(SC$)
2610 IF SC <> 9 THEN GOTO 2620
2611 PRINT #2, SC$;
2612 NX = NX + 1
2613 GOTO 2570

2620 REM ---- READ NUMERIC TARGET ----
2630 TS = NX
2640 OLN = 0
2650 IF NX > LEN(R$) THEN GOTO 2720
2660 SC = ASC(MID$(R$, NX, 1))
2670 IF SC < 48 THEN GOTO 2720
2680 IF SC > 57 THEN GOTO 2720
2690 OLN = OLN * 10 + SC - 48
2700 NX = NX + 1
2710 GOTO 2650

2720 IF NX <> TS THEN GOTO 2750
2730 SP = NX
2740 GOTO 1580

2750 NUM$ = MID$(R$, TS, NX - TS)
2754 TB$ = T$
2755 NX2 = NX
2760 GOSUB 14000
2765 NX = NX2
2766 T$ = TB$
2770 IF F <> 0 THEN GOTO 2775
2771 PRINT #2, NUM$;
2772 GOTO 2790
2775 TB$ = T$
2776 VN = NLN
2777 GOSUB 12000
2778 T$ = TB$
2780 PRINT #2, VS$;

2790 REM ---- COMMA LIST FOR ON ... GOTO/GOSUB ----
2800 IF NX <= LEN(R$) THEN GOTO 2810
2801 SP = NX
2802 GOTO 1580
2810 SC$ = MID$(R$, NX, 1)
2820 IF SC$ <> " " THEN GOTO 2830
2821 PRINT #2, SC$;
2822 NX = NX + 1
2823 GOTO 2800
2830 SC = ASC(SC$)
2840 IF SC <> 9 THEN GOTO 2850
2841 PRINT #2, SC$;
2842 NX = NX + 1
2843 GOTO 2800
2850 IF SC$ = "," THEN GOTO 2860
2851 SP = NX
2852 GOTO 1580
2860 PRINT #2, SC$;
2870 NX = NX + 1
2880 GOTO 2560

12000 REM ==========================================================
12010 REM NUM2S: NUMBER VN TO VS$ WITHOUT STR$
12020 REM Input: VN >= 0
12030 REM Output: VS$
12040 REM ==========================================================
12050 VS$ = ""
12060 IF VN <> 0 THEN GOTO 12090
12070 VS$ = "0"
12080 RETURN
12090 VT = VN
12100 VP = 10000
12110 VF = 0
12120 IF VP < 1 THEN RETURN
12130 VD = 0
12140 IF VT < VP THEN GOTO 12180
12150 VT = VT - VP
12160 VD = VD + 1
12170 GOTO 12140
12180 IF VD <> 0 THEN VF = 1
12190 IF VF <> 0 THEN VS$ = VS$ + CHR$(48 + VD)
12200 VP = VP / 10
12210 GOTO 12120
