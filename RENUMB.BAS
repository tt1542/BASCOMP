5 REM ==========================================================
10 REM RENUMB.BAS - NORMALIZE BASIC LINE NUMBERS
15 REM WITHOUT ARRAYS, MAPPING VIA TEMP FILE
20 REM NEW NUMBERS: STEP,2*STEP,3*STEP,... DEFAULT STEP=10
25 REM COMMAND: RENUMB source target [step]
30 REM ADJUSTS GOTO/GOSUB AND ON...GOTO/GOSUB TARGETS
35 REM ==========================================================
40 I$ = ""
45 O$ = ""
50 MAP$ = "RNUMMAP.TMP"
55 S$ = ""
60 ST = 10
65 C$ = LTRIM$(RTRIM$(COMMAND$))
70 IF LEN(C$) = 0 THEN GOTO 205
75 P = INSTR(C$, " ")
80 IF P <> 0 THEN GOTO 95
85 I$ = C$
90 GOTO 205
95 I$ = LEFT$(C$, P - 1)
100 C$ = MID$(C$, P + 1, LEN(C$) - P)
105 C$ = LTRIM$(RTRIM$(C$))
110 IF LEN(C$) = 0 THEN GOTO 205
115 P = INSTR(C$, " ")
120 IF P <> 0 THEN GOTO 135
125 O$ = C$
130 GOTO 205
135 O$ = LEFT$(C$, P - 1)
140 S$ = MID$(C$, P + 1, LEN(C$) - P)
145 S$ = LTRIM$(RTRIM$(S$))
150 IF LEN(S$) = 0 THEN GOTO 205
155 SP = 1
160 IF SP > LEN(S$) THEN GOTO 185
165 SC = ASC(MID$(S$, SP, 1))
170 IF SC < 48 OR SC > 57 THEN PRINT "BAD STEP": END
175 SP = SP + 1
180 GOTO 160
185 ST = VAL(S$)
190 IF ST < 1 THEN PRINT "BAD STEP": END
195 IF ST > 32760 THEN PRINT "BAD STEP": END
200 GOTO 205
205 IF LEN(I$) <> 0 THEN GOTO 225
210 PRINT "BASIC SOURCE FILE"
215 INPUT I$
220 I$ = LTRIM$(RTRIM$(I$))
225 IF LEN(O$) <> 0 THEN GOTO 245
230 PRINT "BASIC TARGET FILE"
235 INPUT O$
240 O$ = LTRIM$(RTRIM$(O$))
245 IF LEN(I$) <> 0 THEN GOTO 260
250 PRINT "NO SOURCE FILE"
255 END
260 IF LEN(O$) <> 0 THEN GOTO 275
265 PRINT "NO TARGET FILE"
270 END
275 IF I$ <> O$ THEN GOTO 290
280 PRINT "SOURCE AND TARGET MUST NOT BE THE SAME"
285 END
290 GOSUB 310
295 GOSUB 450
300 PRINT "DONE. LINES: "; N
305 END
310 REM ==========================================================
315 REM PASS 1: CREATE MAPPING FILE
320 REM ==========================================================
325 N = 0
330 OPEN I$ FOR INPUT AS #1
335 OPEN MAP$ FOR OUTPUT AS #2
340 IF EOF(1) <> 0 THEN GOTO 435
345 LINE INPUT #1, A$
350 A$ = LTRIM$(RTRIM$(A$))
355 IF LEN(A$) = 0 THEN GOTO 340
360 GOSUB 585
365 IF F <> 0 THEN GOTO 380
370 PRINT "MISSING LINE NUMBER: "; A$
375 CLOSE #1: CLOSE #2: END
380 N = N + 1
385 NN = N * ST
390 IF NN <= 32760 THEN GOTO 415
395 PRINT "TOO MANY LINES FOR STEP "; ST
400 CLOSE #1
405 CLOSE #2
410 END
415 VN = OLN: GOSUB 1410: OS$ = VS$
420 VN = NN: GOSUB 1410: NS$ = VS$
425 PRINT #2, OS$; "="; NS$
430 GOTO 340
435 CLOSE #1
440 CLOSE #2
445 RETURN
450 REM ==========================================================
455 REM PASS 2: REWRITE FILE
460 REM ==========================================================
465 OPEN I$ FOR INPUT AS #1
470 OPEN O$ FOR OUTPUT AS #2
475 N2 = 0
480 IF EOF(1) <> 0 THEN GOTO 565
485 LINE INPUT #1, A$
490 A$ = LTRIM$(RTRIM$(A$))
495 IF LEN(A$) = 0 THEN GOTO 480
500 GOSUB 585
505 IF F <> 0 THEN GOTO 520
510 PRINT "MISSING LINE NUMBER IN PASS 2: "; A$
515 CLOSE #1: CLOSE #2: END
520 N2 = N2 + 1
525 NN = N2 * ST
530 R$ = MID$(A$, P, LEN(A$) - P + 1)
535 R$ = LTRIM$(R$)
540 VN = NN: GOSUB 1410
545 PRINT #2, VS$; " ";
550 GOSUB 850
555 PRINT #2, ""
560 GOTO 480
565 CLOSE #1
570 CLOSE #2
575 KILL MAP$
580 RETURN
585 REM ==========================================================
590 REM READ LEADING LINE NUMBER
595 REM Output: F=1, OLN=number, P=position after number
600 REM ==========================================================
605 F = 0
610 OLN = 0
615 P = 1
620 IF P > LEN(A$) THEN RETURN
625 MC = ASC(MID$(A$, P, 1))
630 IF MC < 48 THEN RETURN
635 IF MC > 57 THEN RETURN
640 F = 1
645 OLN = OLN * 10 + MC - 48
650 P = P + 1
655 GOTO 620
660 REM ==========================================================
665 REM CHECK KEYWORD BOUNDARY
670 REM INPUT: R$, SP, KP
675 REM OUTPUT: BF=1 IF KEYWORD AT POSITION SP IS VALID
680 REM ==========================================================
685 BF = 0
690 IF SP = 1 THEN GOTO 715
695 BC = ASC(MID$(R$, SP - 1, 1))
700 IF BC >= 65 AND BC <= 90 THEN RETURN
705 IF BC >= 48 AND BC <= 57 THEN RETURN
710 IF BC = 95 OR BC = 36 THEN RETURN
715 TP = SP + KP
720 IF TP <= LEN(R$) THEN GOTO 735
725 BF = 1
730 RETURN
735 BC = ASC(MID$(R$, TP, 1))
740 IF BC >= 65 AND BC <= 90 THEN RETURN
745 IF BC = 95 OR BC = 36 THEN RETURN
750 BF = 1
755 RETURN
760 REM ==========================================================
765 REM SEARCH MAPPING: OLN -> NLN
770 REM Output: F=1 found, F=0 not found
775 REM ==========================================================
780 F = 0
785 NLN = OLN
790 OPEN MAP$ FOR INPUT AS #3
795 IF EOF(3) <> 0 THEN GOTO 840
800 LINE INPUT #3, M$
805 EQ = INSTR(M$, "=")
810 IF EQ = 0 THEN GOTO 795
815 X = VAL(LEFT$(M$, EQ - 1))
820 IF X <> OLN THEN GOTO 795
825 NLN = VAL(MID$(M$, EQ + 1, LEN(M$) - EQ))
830 F = 1
835 CLOSE #3: RETURN
840 CLOSE #3
845 RETURN
850 REM ==========================================================
855 REM REWRITE REMAINING LINE R$
860 REM GOTO/GOSUB AND ON...GOTO/GOSUB TARGETS OUTSIDE STRINGS
865 REM ==========================================================
870 SP = 1
875 SQ = 0
880 IF SP > LEN(R$) THEN RETURN
885 SC$ = MID$(R$, SP, 1)
890 IF SC$ <> CHR$(34) THEN GOTO 930
895 IF SQ <> 0 THEN GOTO 910
900 SQ = 1
905 GOTO 915
910 SQ = 0
915 PRINT #2, SC$;
920 SP = SP + 1
925 GOTO 880
930 IF SQ <> 0 THEN GOTO 1055
935 IF SP + 2 > LEN(R$) THEN GOTO 980
940 IF MID$(R$, SP, 3) <> "REM" THEN GOTO 980
945 KP = 3
950 TB$ = T$
955 GOSUB 660
960 T$ = TB$
965 IF BF = 0 THEN GOTO 980
970 PRINT #2, MID$(R$, SP, LEN(R$) - SP + 1);
975 RETURN
980 IF SP + 4 > LEN(R$) THEN GOTO 1015
985 IF MID$(R$, SP, 5) <> "GOSUB" THEN GOTO 1015
990 KP = 5
995 TB$ = T$
1000 GOSUB 660
1005 T$ = TB$
1010 IF BF <> 0 THEN GOTO 1075
1015 IF SP + 3 > LEN(R$) THEN GOTO 1055
1020 IF MID$(R$, SP, 4) <> "GOTO" THEN GOTO 1055
1025 KP = 4
1030 TB$ = T$
1035 GOSUB 660
1040 T$ = TB$
1045 IF BF <> 0 THEN GOTO 1075
1050 GOTO 1055
1055 REM ---- COPY NORMAL CHARACTER ----
1060 PRINT #2, SC$;
1065 SP = SP + 1
1070 GOTO 880
1075 REM ==========================================================
1080 REM REWRITE GOTO/GOSUB TARGET OR COMMA TARGET LIST
1085 REM SP POINTS TO GOTO/GOSUB KEYWORD, KP = KEYWORD LENGTH
1090 REM ==========================================================
1095 PRINT #2, MID$(R$, SP, KP);
1100 NX = SP + KP
1105 REM ---- KEEP SPACES/TABS AFTER KEYWORD ----
1110 IF NX <= LEN(R$) THEN GOTO 1125
1115 SP = NX
1120 GOTO 880
1125 SC$ = MID$(R$, NX, 1)
1130 IF SC$ <> " " THEN GOTO 1150
1135 PRINT #2, SC$;
1140 NX = NX + 1
1145 GOTO 1110
1150 SC = ASC(SC$)
1155 IF SC <> 9 THEN GOTO 1175
1160 PRINT #2, SC$;
1165 NX = NX + 1
1170 GOTO 1110
1175 REM ---- READ NUMERIC TARGET ----
1180 TS = NX
1185 OLN = 0
1190 IF NX > LEN(R$) THEN GOTO 1225
1195 SC = ASC(MID$(R$, NX, 1))
1200 IF SC < 48 THEN GOTO 1225
1205 IF SC > 57 THEN GOTO 1225
1210 OLN = OLN * 10 + SC - 48
1215 NX = NX + 1
1220 GOTO 1190
1225 IF NX <> TS THEN GOTO 1240
1230 SP = NX
1235 GOTO 880
1240 NUM$ = MID$(R$, TS, NX - TS)
1245 TB$ = T$
1250 NX2 = NX
1255 GOSUB 760
1260 NX = NX2
1265 T$ = TB$
1270 IF F <> 0 THEN GOTO 1285
1275 PRINT #2, NUM$;
1280 GOTO 1310
1285 TB$ = T$
1290 VN = NLN
1295 GOSUB 1410
1300 T$ = TB$
1305 PRINT #2, VS$;
1310 REM ---- COMMA LIST FOR ON ... GOTO/GOSUB ----
1315 IF NX <= LEN(R$) THEN GOTO 1330
1320 SP = NX
1325 GOTO 880
1330 SC$ = MID$(R$, NX, 1)
1335 IF SC$ <> " " THEN GOTO 1355
1340 PRINT #2, SC$;
1345 NX = NX + 1
1350 GOTO 1315
1355 SC = ASC(SC$)
1360 IF SC <> 9 THEN GOTO 1380
1365 PRINT #2, SC$;
1370 NX = NX + 1
1375 GOTO 1315
1380 IF SC$ = "," THEN GOTO 1395
1385 SP = NX
1390 GOTO 880
1395 PRINT #2, SC$;
1400 NX = NX + 1
1405 GOTO 1105
1410 REM ==========================================================
1415 REM NUM2S: NUMBER VN TO VS$ WITHOUT STR$
1420 REM Input: VN >= 0
1425 REM Output: VS$
1430 REM ==========================================================
1435 VS$ = ""
1440 IF VN <> 0 THEN GOTO 1455
1445 VS$ = "0"
1450 RETURN
1455 VT = VN
1460 VP = 10000
1465 VF = 0
1470 IF VP < 1 THEN RETURN
1475 VD = 0
1480 IF VT < VP THEN GOTO 1500
1485 VT = VT - VP
1490 VD = VD + 1
1495 GOTO 1480
1500 IF VD <> 0 THEN VF = 1
1505 IF VF <> 0 THEN VS$ = VS$ + CHR$(48 + VD)
1510 VP = VP / 10
1515 GOTO 1470
