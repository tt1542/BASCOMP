C = CPUID()

PRINT "CPU ID: "; C; " - ";

SELECT CASE C
CASE 86
PRINT "INTEL 8086/8088 CLASS"

CASE 120
PRINT "NEC V20/V30 CLASS WITH 8080 EMULATION"

CASE 186
PRINT "INTEL 80186/80188 CLASS"

CASE 286
PRINT "INTEL 80286"

CASE 386
PRINT "INTEL 80386"

CASE 486
PRINT "INTEL 80486 OR COMPATIBLE WITHOUT CPUID"

CASE 586
PRINT "CPUID FAMILY 5"

CASE 686
PRINT "CPUID FAMILY 6"

CASE 1500
PRINT "CPUID FAMILY F"

CASE 999
PRINT "CPUID AVAILABLE, UNKNOWN FAMILY"

CASE ELSE
PRINT "UNKNOWN CPU"
END SELECT

END
