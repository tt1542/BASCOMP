10 REM =========================================
20 REM BASCOMP DEMO: ASCII TUNNEL / TEXT MODE
30 REM Uses DEF SEG, PEEK, POKE, COLOR, LOCATE
40 REM =========================================

50 DEF SEG = 47104

60 OLDCH = PEEK(0)
70 OLDCO = PEEK(1)

80 PAL$ = " .:-=+*#"

90 CLS

100 FOR FRAME = 1 TO 400

110 FOR Y = 0 TO 24
120 FOR X = 0 TO 79

130 DX = X - 40
140 DY = Y - 12

150 D = ABS(DX) + ABS(DY)
160 C = (D + FRAME) AND 15

170 IDX = (C AND 7) + 1
180 CH = ASC(MID$(PAL$, IDX, 1))

190 FG = 15 - (C AND 7)
200 BG = C AND 7
210 COL = BG * 16 + FG

220 ADR = Y * 160 + X * 2

230 POKE ADR, CH
240 POKE ADR + 1, COL

250 NEXT X
260 NEXT Y

270 FOR WAIT = 1 TO 40
280 NEXT WAIT

290 NEXT FRAME

300 POKE 0, OLDCH
310 POKE 1, OLDCO

320 DEF SEG

330 COLOR 7, 0
340 LOCATE 25, 1
350 PRINT "DONE."